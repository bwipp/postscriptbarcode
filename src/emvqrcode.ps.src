% --BEGIN ENCODER emvqrcode--
% --REQUIRES preamble raiseerror setuphooks processoptions parseinput setanycolor fifocache rsecbinary render renmatrix qrcode--
% --DESC: EMV Merchant-Presented QR Code
% --EXAM: 00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5913CORNER BAKERY6009SPRINGTON
% --EXOP:
% --RNDR: renmatrix
% --FMLY: Payments
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
8 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /parseinput dup /uk.co.terryburton.bwipp findresource put
dup /renmatrix dup /uk.co.terryburton.bwipp findresource put
dup /qrcode dup /uk.co.terryburton.bwipp findresource put
begin

/emvqrcode.hex (0123456789ABCDEF) readonly def
/emvqrcode.crcid (6304) readonly def
/emvqrcode.maxlen 12000 def                           % QR Code capacity, with parse escapes

/emvqrcode {

    40 dict begin
    {

    /dontdraw false def
    /parse false def

    {null /apply //processoptions exec} stopped {pop stop} if
    /options exch def
    /barcode exch def

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    %
    % Parse ordinals of the form ^NNN to bytes
    %
    /fncvals <<
        /parse parse
        /parseonly true
        /parsefnc false
    >> def
    barcode length //emvqrcode.maxlen gt {
        /bwipp.emvqrcodeInputTooLong (The input data is too long) //raiseerror exec
    } if
    barcode fncvals //parseinput exec /barcode exch def
    options (parse) undef
    options (parsefnc) undef

    options /sampos known options /samtotal known or options /samparity known or {
        /bwipp.emvqrcodeStructuredAppend (EMV QR Code does not support Structured Append) //raiseerror exec
    } if

    %
    % CRC-16 with polynomial 1021 and initial value FFFF (ISO/IEC 13239)
    %
    /crc16 {  % string -> crc
        16#FFFF exch {
            8 bitshift xor
            8 { dup 16#8000 and 0 ne { 1 bitshift 16#1021 xor } { 1 bitshift } ifelse 16#FFFF and } repeat
        } forall
    } def
    /crchex {  % crc -> string
        4 string exch
        3 -1 0 { 2 index exch 2 index 15 and //emvqrcode.hex exch get put -4 bitshift } for
        pop
    } def

    %
    % The CRC object ends the data, appended when it is not given
    %
    /blen barcode length def
    blen 8 ge { barcode blen 8 sub 4 getinterval //emvqrcode.crcid eq } { false } ifelse {
        barcode 0 blen 4 sub getinterval crc16 crchex barcode blen 4 sub 4 getinterval ne {
            /bwipp.emvqrcodeBadCRC (The CRC must be four upper case hexadecimal digits of the CRC-16 of the data that precedes it) //raiseerror exec
        } if
    } {
        /msg blen 8 add string def
        msg 0 barcode putinterval
        msg blen //emvqrcode.crcid putinterval
        msg 0 blen 4 add getinterval crc16 crchex msg exch blen 4 add exch putinterval
        /barcode msg def
    } ifelse

    %
    % Character positions, since lengths count characters, which may be
    % multibyte UTF-8 in the alternate language template
    %
    /cs [ 0 1 barcode length 1 sub { dup barcode exch get 16#C0 and 16#80 eq { pop } if } for barcode length ] def
    /nchars cs length 1 sub def
    /chars {  % pos len -> string
        1 index add cs exch get exch cs exch get
        exch 1 index sub barcode 3 1 roll getinterval
    } def
    /digits {  % string -> bool  Non-empty, all digits
        dup length 0 gt exch { dup 48 lt exch 57 gt or { pop false } if } forall
    } def
    /ans {  % string -> bool  Printable ASCII
        true exch { dup 32 lt exch 126 gt or { pop false } if } forall
    } def
    /amount {  % string max -> bool  Digits with at most one decimal point
        1 index length ge {
            /dots 0 def /ok true def
            dup { dup 46 eq { pop /dots dots 1 add def } { dup 48 lt exch 57 gt or { /ok false def } if } ifelse } forall
            length dots gt ok and dots 1 le and
        } { pop false } ifelse
    } def

    %
    % Data objects of an ID and a length of two digits each then the value
    %
    /objects {  % start end -> dict  ID to the position and length of its value, or null if malformed or repeated
        /oe exch def /op exch def
        /od 32 dict def
        { % loop
            op oe eq { od exit } if
            op 4 add oe gt { null exit } if
            op 2 chars dup digits not { pop null exit } if
            op 2 add 2 chars dup digits not { pop pop null exit } if
            cvi /ol exch def
            ol 0 eq op 4 add ol add oe gt or od 2 index known or { pop null exit } if
            od exch [ op 4 add ol ] put
            /op op 4 add ol add def
        } loop
    } def
    /root 0 nchars objects def
    root null eq {
        /bwipp.emvqrcodeBadStructure (EMV QR Code data must be data objects of two-digit IDs and lengths, each ID appearing once) //raiseerror exec
    } if
    barcode 0 6 getinterval (000201) ne {
        /bwipp.emvqrcodeBadPayloadFormat (The data must begin with the Payload Format Indicator 01) //raiseerror exec
    } if

    /field {  % id -> value or null
        root exch 2 copy known { get aload pop chars } { pop pop null } ifelse
    } def

    root (01) known {
        (01) field dup (11) ne exch (12) ne and {
            /bwipp.emvqrcodeBadInitiation (The Point of Initiation Method must be 11 for static or 12 for dynamic) //raiseerror exec
        } if
    } if

    %
    % Templates of payment systems and unreserved templates contain a
    % Globally Unique Identifier
    %
    /template {  % id -> dict or null  The data objects within a template
        root exch get aload pop 1 index add objects
    } def
    /accounts 0 def
    root {
        pop dup 2 string cvs cvi /id exch def /k exch def
        id 2 ge id 51 le and { /accounts accounts 1 add def } if
        id 26 ge id 51 le and id 80 ge id 99 le and or {
            k template dup null eq { pop false } { (00) known } ifelse not {
                /bwipp.emvqrcodeBadTemplate (Templates 26 to 51 and 80 to 99 must be data objects containing a Globally Unique Identifier) //raiseerror exec
            } if
        } if
        id 65 ge id 79 le and {
            /bwipp.emvqrcodeRFU (Data object IDs 65 to 79 are reserved) //raiseerror exec
        } if
    } forall
    accounts 0 eq {
        /bwipp.emvqrcodeNoMerchantAccount (At least one Merchant Account Information object, IDs 02 to 51, is required) //raiseerror exec
    } if

    (52) field dup null eq { pop false } { dup length 4 eq exch digits and } ifelse not {
        /bwipp.emvqrcodeBadMCC (The Merchant Category Code must be four digits) //raiseerror exec
    } if
    (53) field dup null eq { pop false } { dup length 3 eq exch digits and } ifelse not {
        /bwipp.emvqrcodeBadCurrency (The Transaction Currency must be the three digits of the ISO 4217 code) //raiseerror exec
    } if
    (54) field dup null eq { pop true } { 13 amount } ifelse not {
        /bwipp.emvqrcodeBadAmount (The Transaction Amount must be up to 13 digits with at most one decimal point) //raiseerror exec
    } if

    %
    % Tip or convenience indicator, with a fixed or percentage fee
    %
    /tip (55) field def
    tip null eq { (56) field null eq (57) field null eq and } {
        tip (01) eq { (56) field null eq (57) field null eq and } {
        tip (02) eq { (56) field dup null eq { pop false } { 13 amount } ifelse (57) field null eq and } {
        tip (03) eq { (57) field dup null eq { pop false } { 5 amount } ifelse (56) field null eq and } {
            false
        } ifelse } ifelse } ifelse
    } ifelse not {
        /bwipp.emvqrcodeBadTip (The Tip or Convenience Indicator must be 01 to prompt for a tip, 02 with a fixed fee, or 03 with a percentage fee) //raiseerror exec
    } if

    (58) field dup null eq { pop false } { dup length 2 eq exch ans and } ifelse not {
        /bwipp.emvqrcodeBadCountry (The Country Code must be the two characters of ISO 3166-1 alpha 2) //raiseerror exec
    } if
    (59) field dup null eq { pop false } { dup length 25 le exch ans and } ifelse not {
        /bwipp.emvqrcodeBadName (The Merchant Name must be up to 25 characters) //raiseerror exec
    } if
    (60) field dup null eq { pop false } { dup length 15 le exch ans and } ifelse not {
        /bwipp.emvqrcodeBadCity (The Merchant City must be up to 15 characters) //raiseerror exec
    } if
    (61) field dup null eq { pop true } { dup length 10 le exch ans and } ifelse not {
        /bwipp.emvqrcodeBadPostalCode (The Postal Code must be up to 10 characters) //raiseerror exec
    } if

    root (62) known not { true } { (62) template null ne } ifelse not {
        /bwipp.emvqrcodeBadAdditionalData (The Additional Data Field Template must be data objects) //raiseerror exec
    } if
    root (64) known not { true } {
        (64) template dup null eq { pop false } {
            /lang exch def
            lang (00) known lang (01) known and
            lang { pop dup (00) eq exch dup (01) eq exch (02) eq or or and } forall
            lang (00) known { lang (00) get 1 get 2 eq and } if
            lang (01) known { lang (01) get 1 get 25 le and } if
            lang (02) known { lang (02) get 1 get 15 le and } if
        } ifelse
    } ifelse not {
        /bwipp.emvqrcodeBadLanguage (The Merchant Information Language Template must contain a Language Preference of two characters and an alternate Merchant Name of up to 25 characters, and optionally a City of up to 15) //raiseerror exec
    } if

    %
    % Get the result of encoding with qrcode
    %
    /uk.co.terryburton.bwipp._dontdraw true def
    barcode options //qrcode exec /args exch def

    args (opt) options put
    args

    _render //renmatrix if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/emvqrcode dup load executeonly /uk.co.terryburton.bwipp defineresource pop
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER emvqrcode--
