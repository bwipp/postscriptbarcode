% --BEGIN ENCODER msi--
% --REQUIRES preamble raiseerror setuphooks processoptions setanycolor render renlinear--
% --DESC: MSI Modified Plessey
% --EXAM: 0123456789
% --EXOP: includetext includecheck includecheckintext
% --RNDR: renlinear
% --FMLY: Less-used Symbols
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
9 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /render dup /uk.co.terryburton.bwipp findresource put
dup /renlinear dup /uk.co.terryburton.bwipp findresource put
begin

/msi.encs [
    (12121212) (12121221) (12122112) (12122121) (12211212)
    (12211221) (12212112) (12212121) (21121212) (21121221)
    (21) (121)
] readonly def

/msi.barchars (0123456789) readonly def

%
% Checksum function lookup dictionary
%
/msi.checkfunc <<
    /mod10      { mod10          } bind
    /mod1010    { mod10    mod10 } bind
    /mod11      { mod11          } bind
    /ncrmod11   { ncrmod11       } bind
    /mod1110    { mod11    mod10 } bind
    /ncrmod1110 { ncrmod11 mod10 } bind
>> readonly def

%
% Number of check digits that each checktype adds, without badmod11
%
/msi.checklen <<
    /mod10 1  /mod1010 2  /mod11 1  /ncrmod11 1  /mod1110 2  /ncrmod1110 2
>> readonly def

/msi {

    16 dict begin
    {

    /dontdraw false def
    /includecheck false def  % Enable/disable checkdigit
    /validatecheck false def
    /includetext false def   % Enable/disable text
    /includecheckintext false def
    /checktype (unset) def
    /badmod11 false def
    /text1font /Courier def
    /text1size 10.0 def
    /text1yoffset -7.0 def
    /height -1.0 def
    /width 0 def

    /propspec false def
    /loosespec false def
    /strictspec false def
    /mag 1.0 def
    /xdim -1.0 def
    /hdim -1.0 def
    /ast (default) def
    /xmin -1.0 def  /xnom -1.0 def  /xmax -1.0 def
    /hnom -1.0 def
    /modunit 1 def

    null /apply //processoptions exec /options exch def
    /global_encoder_defaults //render exec

    /barcode exch def

    barcode length 500 gt {
        /bwipp.msiinputTooLong (The input data is too long) //raiseerror exec
    } if

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    checktype (unset) ne includecheck validatecheck or not and {
        /bwipp.msiCheckTypeWithoutCheck (checktype requires includecheck or validatecheck) //raiseerror exec
    } if

    badmod11 checktype (mod11) ne checktype (ncrmod11) ne and checktype (mod1110) ne and checktype (ncrmod1110) ne and and {
        /bwipp.msiBadMod11Mismatch (badmod11 requires checktype with mod11) //raiseerror exec
    } if

    checktype (unset) eq { /checktype (mod10) def } if

    %
    % Validate the input
    %
    barcode {
        dup 48 lt exch 57 gt or {
            /bwipp.msiBadCharacter (MSI must contain only digits) //raiseerror exec
        } if
    } forall

    /barlen barcode length def     % Length of the code
    /txtlen barlen def

    %
    % Apply AST spec overrides and resolve physical specification
    %
    /msi ast /apply_ast //render exec not { //raiseerror exec } if
    /resolve_strictspec //render exec

    /mod10 {
        /code exch def
        0 0 code {48 sub exch 10 mul add exch} forall pop 2 mul
        0 {1 index 10 mod add exch 10 idiv dup 0 eq {pop exit} if exch} loop
        0 0 code {48 sub add exch} forall exch pop add
        10 mod 10 exch sub 10 mod
        code length 1 add string dup 0 code putinterval dup code length 4 -1 roll 48 add put
    } def

    /mod11 {
        /code exch def
        code length 1 sub code {48 sub exch dup 1 sub exch 6 mod 2 add exch} forall pop
        0 code length {3 1 roll mul add} repeat
        11 mod 11 exch sub 11 mod
        dup 10 eq {
            badmod11 {
                pop code length 2 add string dup 0 code putinterval dup code length (10) putinterval
            } {
                pop /bwipp.msiBadMod11NotSpecified (mod11 check digit is 10 but badmod11 not specified) //raiseerror exec
            } ifelse
        } {
            code length 1 add string dup 0 code putinterval dup code length 4 -1 roll 48 add put
        } ifelse
    } def

    /ncrmod11 {
        /code exch def
        code length 1 sub code {48 sub exch dup 1 sub exch 8 mod 2 add exch} forall pop
        0 code length {3 1 roll mul add} repeat
        11 mod 11 exch sub 11 mod
        dup 10 eq {
            badmod11 {
                pop code length 2 add string dup 0 code putinterval dup code length (10) putinterval
            } {
                pop /bwipp.msiBadMod11NotSpecified (mod11 check digit is 10 but badmod11 not specified) //raiseerror exec
            } ifelse
        } {
            code length 1 add string dup 0 code putinterval dup code length 4 -1 roll 48 add put
        } ifelse
    } def

    %
    % Calculate checksum
    %
    includecheck validatecheck or {
        //msi.checkfunc checktype known not {
            /bwipp.msiBadCharacter (MSI checktype must be mod10, mod1010, mod11, ncrmod11, mod1110 or ncrmod1110) //raiseerror exec
        } if
        /checkfunc //msi.checkfunc checktype get def
    } if

    validatecheck {
        %
        % The check digits are the final digits, one more with badmod11 when a mod11 check digit is 10
        %
        /k0 //msi.checklen checktype get def
        barlen k0 lt {
            /bwipp.msiTooShort (The data must end with the check digits) //raiseerror exec
        } if
        /matched false def
        [ k0 badmod11 { k0 1 add } if ] {
            /k exch def
            matched not barlen k ge and {
                barcode 0 barlen k sub getinterval checkfunc barcode eq {
                    /matched true def
                    /txtlen barlen k sub def
                } if
            } if
        } forall
        matched not {
            /bwipp.msiBadCheckDigit
            [ (Incorrect MSI check digits provided: expected )
              barcode 0 barlen k0 sub getinterval checkfunc dup barlen k0 sub dup 3 -1 roll length exch sub getinterval
              (, not ) barcode barlen k0 sub k0 getinterval ]
            dup 0 exch {length add} forall string
            exch 0 exch { dup length 2 index add 3 index 4 2 roll putinterval } forall pop
            //raiseerror exec
        } if
        includecheckintext {/txtlen barlen def} if
    } {
        includecheck {
            barcode checkfunc /barcode exch def
            /checkdigit barcode barlen barcode length barlen sub getinterval dup length string copy /report //render exec
            /barlen barcode length def
            includecheckintext {/txtlen barlen def} if
        } if
    } ifelse

    /sbs barlen 8 mul 5 add string def

    %
    % Put start character
    %
    sbs 0 //msi.encs 10 get putinterval

    0 1 barlen 1 sub {
        /i exch def
        barcode i 1 getinterval //msi.barchars exch search
        pop                                % Discard true leaving pre
        length /indx exch def              % indx is the length of pre
        pop pop                            % Discard seek and post
        /enc //msi.encs indx get def       % Get the indxth encoding
        sbs i 8 mul 2 add enc putinterval  % Put encoded digit into sbs
    } for

    %
    % Put the end character
    %
    sbs barlen 8 mul 2 add //msi.encs 11 get putinterval

    /height /resolve_height //render exec dup -1 eq { pop 1.0 } if def

    <<
    /ren /renlinear
    /sbs [sbs {48 sub} forall]
    /bhs [sbs length 1 add 2 idiv {height} repeat]
    /bbs [sbs length 1 add 2 idiv {0} repeat]
    includetext {
        /txt [ [barcode 0 txtlen getinterval 0 0 text1font text1size] ]
        /text1xalign (center)
    } if
    /strictspec strictspec
    /loosespec loosespec
    /xdim xdim
    /xmin xmin
    /xmax xmax
    /modunit modunit
    /opt options
    >>

    _render //renlinear if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/msi dup load executeonly /uk.co.terryburton.bwipp defineresource pop
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER msi--
