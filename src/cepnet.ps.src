% --BEGIN ENCODER cepnet--
% --REQUIRES preamble raiseerror setuphooks processoptions setanycolor render renlinear--
% --DESC: Brazilian CEPNet
% --EXAM: 01234567
% --EXOP: includetext includecheckintext
% --RNDR: renlinear
% --FMLY: Postal Symbols
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
9 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /render dup /uk.co.terryburton.bwipp findresource put
dup /renlinear dup /uk.co.terryburton.bwipp findresource put
begin

/cepnet.barchars (0123456789) readonly def

/cepnet.encs [
    (55222) (22255) (22525) (22552) (25225)
    (25252) (25522) (52225) (52252) (52522)
    (5) (5)
] readonly def

/cepnet {

    32 dict begin
    {

    /dontdraw false def
    /includetext false def
    /validatecheck false def
    /includecheckintext false def
    /text1font /Courier def
    /text1size 10.0 def
    /text1yoffset -7.0 def
    /height -1.0 def
    /width 0 def

    /propspec false def
    /loosespec false def
    /strictspec false def
    /mag 1.0 def
    /xdim -1.0 def
    /hdim -1.0 def
    /ast (default) def
    /xmin -1.0 def  /xnom -1.0 def  /xmax -1.0 def
    /hnom -1.0 def
    /modunit 1 def

    null /apply //processoptions exec /options exch def
    /global_encoder_defaults //render exec

    /barcode exch def

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    /barlen barcode length validatecheck {1 sub} if def

    %
    % Validate the input
    %
    barlen 8 ne {
        /bwipp.cepnetBadLength (CEPNet must be 8 digits excluding check digit) //raiseerror exec
    } if
    barcode {
        dup 48 lt exch 57 gt or {
            /bwipp.cepnetBadCharacter (CEPNet must contain only digits) //raiseerror exec
        } if
    } forall

    %
    % Apply AST spec overrides and resolve physical specification
    %
    /cepnet ast /apply_ast //render exec not { //raiseerror exec } if
    /resolve_strictspec //render exec

    /checksum 0 def
    0 1 barlen 1 sub {
        /i exch def
        /checksum checksum barcode i get 48 sub add def
    } for
    /checksum 10 checksum 10 mod sub 10 mod def
    validatecheck {
        barcode barlen get //cepnet.barchars checksum get ne {
            /bwipp.cepnetBadCheckDigit
            [ (Incorrect CEPNet check digit provided: expected ) //cepnet.barchars checksum 1 getinterval (, not ) barcode barlen 1 getinterval ]
            dup 0 exch {length add} forall string
            exch 0 exch { dup length 2 index add 3 index 4 2 roll putinterval } forall pop
            //raiseerror exec
        } if
        /barcode barcode 0 barlen getinterval def
    } if

    /resolve_height //render exec dup -1 eq { pop 0.125 } if /height exch def

    /bhs barlen 5 mul 7 add array def

    %
    % Put start character
    %
    /enc //cepnet.encs 10 get def
    /heights enc length array def
    0 1 enc length 1 sub {
        /j exch def
        heights j enc j 1 getinterval cvi height mul 5 div put
    } for
    bhs 0 heights putinterval   % Put encoded digit into bhs

    0 1 barlen 1 sub {
        /i exch def
        /enc //cepnet.encs barcode i get 48 sub get def
        /heights enc length array def
        0 1 enc length 1 sub {
            /j exch def
            heights j enc j 1 getinterval cvi height mul 5 div put
        } for
        bhs i 5 mul 1 add heights putinterval   % Put encoded digit into bhs
    } for

    %
    % Put the checksum character
    %
    /enc //cepnet.encs checksum get def
    /heights enc length array def
    0 1 enc length 1 sub {
        /j exch def
        heights j enc j 1 getinterval cvi height mul 5 div put
    } for
    bhs barlen 5 mul 1 add heights putinterval

    /text includecheckintext {
        barlen 1 add string dup 0 barcode putinterval dup barlen //cepnet.barchars checksum 1 getinterval putinterval
    } { barcode } ifelse def

    %
    % Put end character
    %
    /enc //cepnet.encs 11 get def
    /heights enc length array def
    0 1 enc length 1 sub {
        /j exch def
        heights j enc j 1 getinterval cvi height mul 5 div put
    } for
    bhs barlen 5 mul 6 add heights putinterval

    <<
    /ren /renlinear
    /bhs bhs
    /bbs [bhs length {0} repeat]
    %
    % Bars of 0.020 and spaces of 0.026 inches, in points, or in modules
    % under a spec mode, which scales them
    %
    /sbs strictspec propspec or
        { [bhs length 1 sub {1 1.3} repeat 1] }
        { [bhs length 1 sub {1.44 1.872} repeat 1.44] }
    ifelse
    %
    % Quiet zones of 10X at the sides and 1.016 mm above and below, at the
    % minimum bar width under a spec mode
    %
    /borderleft strictspec propspec or { 10.0 } { 14.4 } ifelse
    /borderright strictspec propspec or { 10.0 } { 14.4 } ifelse
    /bordertop strictspec propspec or { 3.0 } { 2.88 } ifelse
    /borderbottom strictspec propspec or { 3.0 } { 2.88 } ifelse
    includetext {
        /txt [ [text 0 0 text1font text1size] ]
        /text1xalign (center)
    } if
    /strictspec strictspec
    /loosespec loosespec
    /xdim xdim
    /xmin xmin
    /xmax xmax
    /modunit modunit
    /opt options
    >>

    _render //renlinear if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/cepnet dup load executeonly /uk.co.terryburton.bwipp defineresource pop
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER cepnet--
