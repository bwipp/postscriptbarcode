% --BEGIN ENCODER ultracode--
% --REQUIRES preamble raiseerror setuphooks processoptions parseinput setanycolor fifocache rsecprime render renmatrix--
% --DESC: Ultracode
% --EXAM: Awesome colours!
% --EXOP: eclevel=EC2
% --RNDR: renmatrix
% --FMLY: Two-dimensional symbols
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
17 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /parseinput dup /uk.co.terryburton.bwipp findresource put
dup /fifocache dup /uk.co.terryburton.bwipp findresource put
dup /rsecprime dup /uk.co.terryburton.bwipp findresource put
dup /setuphooks dup /uk.co.terryburton.bwipp findresource put
dup /renmatrix dup /uk.co.terryburton.bwipp findresource put
dup /render dup /uk.co.terryburton.bwipp findresource put
begin

/ultracode [/before /after] //setuphooks exec

(setup.define) //ultracode.before exec

/ultracode.metrics [
    % rows  minc  maxc  mcol  maxcol
    [   2     7    37     5     21  ]
    [   3    36    84    13     30  ]
    [   4    85   161    22     43  ]
    [   5   142   282    29     60  ]
] readonly def

/ultracode.tiles [
    13135  13136  13153  13156  13163  13165  13513  13515  13516  13531  %   0-9
    13535  13536  13561  13563  13565  13613  13615  13616  13631  13635  %  10-19
    13636  13651  13653  13656  15135  15136  15153  15163  15165  15313  %  20-29
    15315  15316  15351  15353  15356  15361  15363  15365  15613  15615  %  30-39
    15616  15631  15635  15636  15651  15653  15656  16135  16136  16153  %  40-49
    16156  16165  16313  16315  16316  16351  16353  16356  16361  16363  %  50-59
    16365  16513  16515  16516  16531  16535  16536  16561  16563  16565  %  60-69
    31315  31316  31351  31356  31361  31365  31513  31515  31516  31531  %  70-79
    31535  31536  31561  31563  31565  31613  31615  31631  31635  31636  %  80-89
    31651  31653  31656  35131  35135  35136  35151  35153  35156  35161  %  90-99
    35163  35165  35315  35316  35351  35356  35361  35365  35613  35615  % 100-109
    35616  35631  35635  35636  35651  35653  35656  36131  36135  36136  % 110-119
    36151  36153  36156  36163  36165  36315  36316  36351  36356  36361  % 120-129
    36365  36513  36515  36516  36531  36535  36536  36561  36563  36565  % 130-139
    51313  51315  51316  51351  51353  51356  51361  51363  51365  51513  % 140-149
    51516  51531  51536  51561  51563  51613  51615  51616  51631  51635  % 150-159
    51636  51651  51653  51656  53131  53135  53136  53151  53153  53156  % 160-169
    53161  53163  53165  53513  53516  53531  53536  53561  53563  53613  % 170-179
    53615  53616  53631  53635  53636  53651  53653  53656  56131  56135  % 180-189
    56136  56151  56153  56156  56161  56163  56165  56313  56315  56316  % 190-199
    56351  56353  56356  56361  56363  56365  56513  56516  56531  56536  % 200-209
    56561  56563  61313  61315  61316  61351  61353  61356  61361  61363  % 210-219
    61365  61513  61515  61516  61531  61535  61536  61561  61563  61565  % 220-229
    61615  61631  61635  61651  61653  63131  63135  63136  63151  63153  % 230-239
    63156  63161  63163  63165  63513  63515  63516  63531  63535  63536  % 240-249
    63561  63563  63565  63613  63615  63631  63635  63651  63653  65131  % 250-259
    65135  65136  65151  65153  65156  65161  65163  65165  65313  65315  % 260-269
    65316  65351  65353  65356  65361  65363  65365  65613  65615  65631  % 270-279
    65635  65651  65653  56565  51515                                     % 280-284
] readonly def

/ultracode.dccurev1 [
    51363  51563  51653  53153  53163  53513  53563  53613  %  0-7
    53653  56153  56163  56313  56353  56363  56513  56563  %  8-15
    51316  51356  51536  51616  53156  53516  53536  53616  % 16-23
    53636  53656  56136  56156  56316  56356  56516  56536  % 24-31
] readonly def

/ultracode.dcclrev1 [
    61351  61361  61531  61561  61631  61651  63131  63151  %  0-7
    63161  63531  63561  63631  65131  65161  65351  65631  %  8-15
    31351  31361  31531  31561  31631  31651  35131  35151  % 16-23
    35161  35361  35631  35651  36131  36151  36351  36531  % 24-31
] readonly def

/ultracode.dccurev2 [
    15316  16316  13516  16516  13616  15616  13136  15136  %  0-7
    16136  13536  16536  13636  13156  16156  15356  13656  %  8-15
    15313  16313  13513  16513  13613  15613  13153  15153  % 16-23
    16153  16353  13653  15653  13163  15163  15363  13563  % 24-31
] readonly def

/ultracode.dcclrev2 [
    36315  36515  35615  35135  36135  31535  36535  31635  %  0-7
    35635  35165  36165  31365  35365  36365  31565  36565  %  8-15
    61315  65315  63515  61615  65135  61535  63535  61635  % 16-23
    63635  65635  63165  65165  61365  65365  61565  63565  % 24-31
] readonly def

/ultracode.colormap <<
    0 (FFFFFF)  % W
    9 (000000)  % K
    1 (00FFFF)  % C
    3 (FF00FF)  % M
    5 (FFFF00)  % Y
    6 (00FF00)  % G
>> readonly def

/ultracode.qccfact [ 0 1 2 4 6 8 ] readonly def

/ultracode.c43set1 (ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 .%) readonly def
/ultracode.c43set2 (abcdefghijklmnopqrstuvwxyz:/?#[]@=_&!.-) readonly def
/ultracode.head06 <5b293e1e30361d> readonly def  % [)> RS 06 GS
/ultracode.tail06 <1e04> readonly def            % RS EOT
/ultracode.c43set3 <ffffffffffffffffffffffffffffffffffffff7b7d2c28295e2a60222b273c3e7c243b7e5cffffffffffff> readonly def

/ultracode.latevars dup 8 dict def load /init {

    (setup.latevars) //ultracode.before exec

    currentglobal
    true setglobal

    //ultracode.latevars begin

    /rsalog [ 1 282 {dup 3 mul 283 mod} repeat ] readonly def
    /rslog 283 array def
    1 1 282 {dup rsalog exch get exch rslog 3 1 roll put} for
    /rslog rslog readonly def

    % C43 value of each byte in Sets 1, 2 and 3, or 255
    [ //ultracode.c43set1 //ultracode.c43set2 //ultracode.c43set3 ] {
        256 string dup 0 1 255 {255 put dup} for pop
        exch 0 1 2 index length 1 sub {
            2 copy get dup 128 lt {  % lookup set k c
                exch 3 index 3 1 roll put
            } {pop pop} ifelse
        } for pop readonly
    } forall
    /c43v3 exch def /c43v2 exch def /c43v1 exch def

    /init { //ultracode.latevars {def} forall } def

    end

    //ultracode.latevars /init get exec

    setglobal

    (setup.latevars) //ultracode.after exec

} bind put

/uk.co.terryburton.bwipp.global_ctx dup where {
    exch get /preload known {//ultracode.latevars /init get exec} if
} {pop} ifelse

%
% Generate Reed-Solomon coefficients for a given k
%
/ultracode.gencoeffs {
    /coeffs [ 1 k {0} repeat ] def
    1 1 k {  % i
        coeffs 1 index 2 copy 1 sub get put      % coeffs[i] = coeffs[i-1]
        dup 1 sub -1 1 {  % j
            coeffs exch 2 copy get               % ... coeffs j coeffs[j]
            rslog exch get 3 index add 282 mod   % ... (log(coeffs[j]) + i) mod 282
            rsalog exch get                      % p = coeffs[j] * ai
            coeffs 2 index 1 sub get             % ... coeffs[j-1]
            add 283 mod put                      % coeffs[j] = (p + coeffs[j-1]) mod 283
        } for
        coeffs 0 2 copy get                      % ... coeffs 0 coeffs[0]
        rslog exch get 3 index add 282 mod       % ... (log(coeffs[0]) + i) mod 282
        rsalog exch get put                      % coeffs[0] = coeffs[0] * ai
        pop  % i
    } for
    /coeffs coeffs 0 coeffs length 1 sub getinterval def
    coeffs length 1 sub -2 0 { coeffs exch 2 copy get 283 exch sub put } for

    %
    % Deliver the coefficients reversed, as rsecprime requires
    %
    [ k 1 sub -1 0 { coeffs exch get } for ] readonly
} bind def

%
% FIFO cache for ECC polynomials
%
% 30 unique keys: qcc=factor*ceil(mcc/25)+5 within capacity yields sparse values 3-77
%
/ultracode.coeffscachemax 30 def      % Override with global_ctx.ultracode.coeffscachemax
/ultracode.coeffscachelimit 842 def   % Override with global_ctx.ultracode.coeffscachelimit
/uk.co.terryburton.bwipp.global_ctx dup where {
    exch get
    dup /ultracode.coeffscachemax 2 copy known {get /ultracode.coeffscachemax exch def} {pop pop} ifelse
    /ultracode.coeffscachelimit 2 copy known {get /ultracode.coeffscachelimit exch def} {pop pop} ifelse
} {pop} ifelse

/ultracode.coeffscache ultracode.coeffscachemax ultracode.coeffscachelimit //fifocache exec def

/ultracode.coeffscachefetch {
    /k exch def
    k
    { //ultracode.gencoeffs exec }
    { length }
    //ultracode.coeffscache /fetch get exec
} bind def

/ultracode {

    64 dict begin
    {

    (input.processoptions) //ultracode.before exec

    /dontdraw false def
    /eclevel (EC2) def     % EC1-EC5, and EC0 for rev 1
    /fixedeclevel false def
    /rows -1 def
    /columns -1 def
    /parse false def
    /parsefnc false def
    /start -1 def          % Chosen by the encoder; 257 for raw codewords and revision 1
    /link1 0 def
    /raw false def
    /readerinit false def
    /rev 2 def             % Ultracode specification revision
    /sampos -1 def
    /samtotal -1 def
    /adctype -1 def
    /strictspec false def
    /propspec false def
    /loosespec false def
    /mag 1.0 def
    /xdim -1.0 def
    /ast (default) def
    /xnom -1.0 def
    /xmin -1.0 def
    /xmax -1.0 def

    null /apply //processoptions exec /options exch def
    /global_encoder_defaults //render exec

    /barcode exch def

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    /modunit 2 def
    /uk.co.terryburton.bwipp.global_ctx dup where {
        exch get /default_modunit 2 copy known {get /modunit exch def} {pop pop} ifelse
    } {pop} ifelse

    %
    % Apply AST spec overrides and resolve physical specification
    %
    /ultracode ast /apply_ast //render exec not { //raiseerror exec } if
    /resolve_strictspec //render exec

    (input.processoptions) //ultracode.after exec

    //ultracode.latevars /init get exec

    (input.validate) //ultracode.before exec

    % 282 max codewords; 4x for ^NNN parse expansion
    barcode length 2500 gt {
        /bwipp.ultracodeInputTooLong (The input data is too long) //raiseerror exec
    } if

    rev dup 1 ne exch 2 ne and {
        /bwipp.ultracodeInvalidRevision (Valid revisions are 1 and 2) //raiseerror exec
    } if

    eclevel length 3 eq dup {
       pop eclevel 0 2 getinterval (EC) eq dup {
           pop eclevel 2 get 48 sub dup rev 2 eq {1} {0} ifelse ge exch 5 le and
       } if
    } if
    not {
        /bwipp.ultracodeInvalidErrorCorrectionLevel (Valid error correction levels are EC1 to EC5, and EC0 for legacy revision 1) //raiseerror exec
    } if

    start -1 ne {
        start 0 lt start 282 gt or {
            /bwipp.ultracodeBadStart (The start character must be a codeword from 0 to 282) //raiseerror exec
        } if
        raw not rev 2 eq and {
            /bwipp.ultracodeStartWithoutRaw (The start character can only be given with raw codewords or revision 1) //raiseerror exec
        } if
    } {
        rev 1 eq raw or {/start 257 def} if
    } ifelse
    link1 0 ne link1 1 ne and {
        /bwipp.ultracodeBadLink1 (The link1 flag must be 0 or 1) //raiseerror exec
    } if
    % Otherwise the encoder writes the Symbol Control Region and sets link1 itself
    link1 1 eq raw not and {
        /bwipp.ultracodeLink1WithoutRaw (The link1 flag can only be given with raw codewords) //raiseerror exec
    } if

    rows -1 ne rows 2 lt rows 5 gt or and {
        /bwipp.ultracodeInvalidRows (The rows must be from 2 to 5) //raiseerror exec
    } if
    columns -1 ne {
        % Secondary vertical clock tracks are interior columns
        columns 5 lt columns 60 gt or columns 15 eq or columns 31 eq or columns 47 eq or {
            /bwipp.ultracodeInvalidColumns (The columns must be from 5 to 60, excluding 15, 31 and 47) //raiseerror exec
        } if
    } if

    /structapp sampos -1 ne samtotal -1 ne or def
    structapp {
        rev 1 eq raw or {
            /bwipp.ultracodeSAMunavailable (Structured Append is not available for revision 1 or raw codewords) //raiseerror exec
        } if
        sampos -1 eq samtotal -1 eq or {
            /bwipp.ultracodeSAMincomplete (Structured Append requires sampos and samtotal) //raiseerror exec
        } if
        samtotal 2 lt samtotal 8 gt or {
            /bwipp.ultracodeBadSAMtotal (The samtotal must be from 2 to 8) //raiseerror exec
        } if
        sampos 1 lt sampos samtotal gt or {
            /bwipp.ultracodeBadSAMpos (The sampos must be from 1 to samtotal) //raiseerror exec
        } if
    } if

    adctype -1 ne {
        % Table 11 reserves 10-19, 35-39, 46-49 and 51-59
        adctype 0 lt adctype 69 gt or
        adctype 10 ge adctype 19 le and or
        adctype 35 ge adctype 39 le and or
        adctype 46 ge adctype 49 le and or
        adctype 51 ge adctype 59 le and or {
            /bwipp.ultracodeBadADCtype (The adctype must be an Associated Data Carrier type from Table 11) //raiseerror exec
        } if
        % The Symbol Control Region holds one SCR type
        structapp {
            /bwipp.ultracodeADCwithSAM (An Associated Data Carrier is not available with Structured Append) //raiseerror exec
        } if
        raw {
            /bwipp.ultracodeADCwithRaw (An Associated Data Carrier is not available with raw codewords) //raiseerror exec
        } if
    } if

    % Raw codewords with link1 begin with a Symbol Control Region, so they place FNC3 themselves
    readerinit link1 1 eq and {
        /bwipp.ultracodeReaderinitLink1 (Reader initialisation is not available with link1, so the raw codewords can include FNC3 directly) //raiseerror exec
    } if

    (input.validate) //ultracode.after exec

    raw {

        (input.encoding.raw) //ultracode.before exec

        /dcws barcode length array def
        /i 0 def /j 0 def
        { % loop
            i barcode length 3 sub ge {exit} if
            barcode i get 94 ne {exit} if
            barcode i 1 add 3 getinterval false 1 index {
                dup 48 lt exch 57 gt or { pop true } if
            } forall { pop exit } if
            cvi /cw exch def
            cw 284 gt {
                /bwipp.ultracodeBadRawCodeword (Raw codewords must be 0 to 284) //raiseerror exec
            } if
            dcws j cw put
            /i i 4 add def
            /j j 1 add def
        } loop
        i barcode length ne {
            /bwipp.ultracodeBadRawFormat (Raw codewords must be formatted as ^NNN) //raiseerror exec
        } if
        /dcws dcws 0 j getinterval def
        readerinit {  % FNC3 precedes the raw codewords
            /dcws j 1 add array dup 0 269 put dup 1 dcws putinterval def
        } if

        (input.encoding.raw) //ultracode.after exec

    } {

        (input.preprocess) //ultracode.before exec

        % Parse the input
        /fn1 -1 def  /fn3 -2 def
        /fncvals <<
            /parse parse
            /parsefnc parsefnc
            rev 2 eq {/eci true} if
            (FNC1) fn1
            (FNC3) fn3
        >> def
        barcode fncvals //parseinput exec /msg exch def
        /msglen msg length def

        %
        % Reader initialisation leads with FNC3. Readers do not transmit the data, so FNC1 in first
        % position would declare a format that is never received
        %
        readerinit {
            msglen 0 gt { msg 0 get fn1 eq } { false } ifelse {
                /bwipp.ultracodeReaderinitFNC1 (Reader initialisation is not available with FNC1 in first position) //raiseerror exec
            } if
            /msg msglen 1 add array dup 0 fn3 put dup 1 msg putinterval def
            /msglen msg length def
        } if

        structapp {
            msglen 0 gt { msg 0 get fn1 eq } { false } ifelse {
                /bwipp.ultracodeSAMfnc1 (Structured Append is not available with FNC1 in first position) //raiseerror exec
            } if
            msg {
                fn3 eq {
                    /bwipp.ultracodeSAMfnc3 (Structured Append is not available with FNC3) //raiseerror exec
                } if
            } forall
        } if

        msg {
            -1000000 exch sub 811799 gt {
                /bwipp.ultracodeBadECI (Ultracode supports ECIs up to 811799) //raiseerror exec
            } if
        } forall

        rev 2 eq {
            % ECIs are not transmitted from GS1 symbols
            msglen 0 gt { msg 0 get fn1 eq } { false } ifelse {
                msg {
                    -1000000 le {
                        /bwipp.ultracodeECIwithFNC1 (ECIs are not available with FNC1 in first position) //raiseerror exec
                    } if
                } forall
            } if
            % FNC1 in second position has no defined transmission
            msglen 1 gt { msg 0 get fn1 ne msg 1 get fn1 eq and } { false } ifelse {
                /bwipp.ultracodeFNC1secondPosition (FNC1 is not available in the second data position) //raiseerror exec
            } if
        } if

        % Most characters that 279 data codewords can carry, at two digits per codeword
        msglen 558 gt {
            /bwipp.ultracodeInputTooLong (The input data is too long) //raiseerror exec
        } if

        (input.preprocess) //ultracode.after exec

        (input.encoding.normal) //ultracode.before exec

        %
        % Symbol control region, signalled by Link1: a Structured Append Group without a File Number is SCR type
        % 70*2 + 8*(n-1) + (x-1), and an Associated Data Carrier without a File Number is SCR type 70*0 + type
        %
        /scr
            structapp { [ 140 samtotal 1 sub 8 mul add sampos 1 sub add ] /link1 1 def } {
            adctype -1 ne { [ adctype ] /link1 1 def } {
                []
            } ifelse } ifelse
        def
        /scp [] def     % Empty start sequence parameters

        rev 1 eq {

            /cws [
                msg {
                    dup fn1 eq {pop 268} if
                    dup fn3 eq {pop 269} if
                } forall
            ] def

        } {

            %
            % Shortest encodation over Primary Mode (P), Numeric Submode (N) and
            % variable-length C43 groups, as states carrying the calling mode,
            % the C43 set and the count of C43 values modulo 3. Costs are in
            % thirds of a codeword: a codeword costs 3 and a C43 value 2.
            %
            % Back pointers hold [i state event], an event being one of:
            %   [0 codewords] [1 opcode] [2 c43values] [3 pads exit] [4 opcode c43values size]
            %
            /ns 14 def
            /inf 99999999 def
            /dpcost msglen 1 add ns mul array def
            0 1 dpcost length 1 sub {dpcost exch inf put} for
            /dpback msglen 1 add ns mul array def

            /relax {  % j t c i s event
                /ev exch def /rs exch def /ri exch def /rc exch def
                exch ns mul add /ridx exch def
                rc dpcost ridx get lt {
                    dpcost ridx rc put
                    dpback ridx [ri rs ev] put
                } if
            } def

            /cst { exch 1 sub 3 mul add exch 6 mul add 2 add } def  % caller set r -> state

            /c43val {  % b set -> v or 255
                1 index dup 0 lt exch 127 gt or {pop pop 255} {
                    dup 1 eq {pop c43v1} {2 eq {c43v2} {c43v3} ifelse} ifelse exch get
                } ifelse
            } def

            /isdigit { dup 48 ge exch 57 le and } def

            % An ISO/IEC 15434 Format 06 message in a single symbol: [270] in the first data position
            /mac06 false def
            structapp not msglen 9 ge and {
                /mac06 true def
                0 1 6 { dup msg exch get exch //ultracode.head06 exch get ne {/mac06 false def} if } for
                0 1 1 { dup msg exch msglen 2 sub add get exch //ultracode.tail06 exch get ne {/mac06 false def} if } for
            } if
            mac06 {
                /msg msg 7 msglen 9 sub getinterval def
                /msglen msg length def
            } if

            /gs1 msglen 0 gt mac06 not and { msg 0 get fn1 eq } { false } ifelse def
            gs1 {
                dpcost 1 ns mul 1 add 0 put
            } {
                dpcost 0 0 put
            } ifelse

            0 1 msglen {
                /i exch def
                /atend i msglen eq def
                /row i ns mul def

                % Exit variable C43 groups to the caller after whole triplets with [282], or padded at the end
                0 1 1 { /caller exch def
                    1 1 2 { /set exch def
                        0 1 2 { /r exch def
                            caller set r cst /t exch def
                            dpcost row t add get dup inf lt r 0 eq atend or and {
                                3 r sub 3 mod /pad exch def
                                pad 2 mul add atend {0} {3} ifelse add
                                i caller 3 -1 roll i t [3 pad atend not] relax
                            } {pop} ifelse
                        } for
                    } for
                } for

                atend not {

                    /cp dpcost row get def
                    /cn dpcost row 1 add get def
                    i 1 cp 3 add i 0 [0 [267]] relax
                    i 0 cn 3 add i 1 [0 [282]] relax
                    /cp dpcost row get def
                    /cn dpcost row 1 add get def
                    i 0 1 0 cst cp 3 add i 0 [1 260] relax
                    i 0 2 0 cst cp 3 add i 0 [1 266] relax
                    i 1 1 0 cst cn 3 add i 1 [1 278] relax

                    /b msg i get def

                    % Primary Mode
                    cp inf lt {
                        b 0 ge {
                            i 1 add 0 cp 3 add i 0 [0 [b]] relax
                        } {
                        b fn1 eq {
                            i 1 add 0 cp 3 add i 0 [0 [268]] relax
                        } {
                        b fn3 eq {
                            i 1 add 0 cp 3 add i 0 [0 [269]] relax
                        } {
                            /e -1000000 b sub def  % ECI as digit pairs after [273], [274] or [275]
                            /e [
                                e 100 lt {273} {e 10000 lt {274} {275 e 10000 idiv 128 add} ifelse e 100 idiv 100 mod 128 add} ifelse
                                e 100 mod 128 add
                            ] def
                            i 1 add 0 cp e length 3 mul add i 0 [0 e] relax
                        } ifelse
                        } ifelse
                        } ifelse
                    } if

                    % Numeric Submode
                    cn inf lt {
                        b 0 ge b 127 le and {
                            i 1 add 1 cn 3 add i 1 [0 [b]] relax
                        } if
                        i 1 add msglen lt {
                            b isdigit msg i 1 add get isdigit and {
                                i 2 add 1 cn 3 add i 1 [0 [b 48 sub 10 mul msg i 1 add get 48 sub add 128 add]] relax
                            } if
                        } if
                        b fn1 eq {
                            i 1 add 1 cn 3 add i 1 [0 [272]] relax
                        } if
                    } if

                    % Variable-length C43 groups
                    0 1 1 { /caller exch def
                        1 1 2 { /set exch def
                            /oset 3 set sub def
                            0 1 2 { /r exch def
                                caller set r cst /t exch def
                                /c dpcost row t add get def
                                c inf lt {
                                    /r1 r 1 add 3 mod def
                                    /r2 r 2 add 3 mod def
                                    /v b set c43val def
                                    v 255 ne {
                                        i 1 add caller set r1 cst c 2 add i t [2 [v]] relax
                                    } if
                                    /v b oset c43val def
                                    v 255 ne {
                                        i 1 add caller set r2 cst c 4 add i t [2 [40 v]] relax
                                        i 1 add caller oset r2 cst c 4 add i t [2 [39 v]] relax
                                    } if
                                    /v b 3 c43val def
                                    v 255 ne {
                                        i 1 add caller set r2 cst c 4 add i t [2 [41 v]] relax
                                    } if
                                } if
                            } for
                        } for
                    } for

                    % Fixed-length C43 groups of 6, 9, 12 or 15 values need no exit codeword
                    [ [0 1 256] [0 2 262] [1 1 274] ] {
                        aload pop /base exch def /set exch def /caller exch def
                        /c dpcost row caller add get def
                        c inf lt {
                            /fwin msglen i sub 1 add def
                            /fpos fwin array def
                            /fput {  % pos set r count values
                                /fv exch def /fc exch def
                                exch 1 sub 3 mul add /fk exch def
                                /fp exch i sub def
                                fpos fp get null eq {fpos fp 6 array put} if
                                fpos fp get fk get dup null eq {pop true} {0 get fc gt} ifelse {
                                    fpos fp get fk [fc fv] put
                                } if
                            } def
                            i set 0 0 [] fput
                            0 1 fwin 1 sub { /fp0 exch def
                                /fst fpos fp0 get def
                                fst null ne {
                                    /j i fp0 add def
                                    fp0 0 gt {
                                        /best null def
                                        fst {
                                            dup null ne {
                                                best null eq {/best exch def} {
                                                    dup 0 get best 0 get lt {/best exch def} {pop} ifelse
                                                } ifelse
                                            } {pop} ifelse
                                        } forall
                                        /size best 0 get 2 add 3 idiv 3 mul dup 6 lt {pop 6} if def
                                        j caller c 3 add size 2 mul add i caller [4 base size 3 idiv 2 sub add best 1 get size] relax
                                    } if
                                    j msglen lt {
                                        /bj msg j get def
                                        0 1 5 { /k exch def
                                            fst k get dup null ne {
                                                aload pop /fvals exch def /fcnt exch def
                                                fcnt 15 lt {
                                                    /fs k 3 idiv 1 add def /fr k 3 mod def
                                                    /fother 3 fs sub def
                                                    /v bj fs c43val def
                                                    v 255 ne {
                                                        j 1 add fs fr 1 add 3 mod fcnt 1 add [fvals aload pop v] fput
                                                    } if
                                                    fcnt 14 lt {
                                                        /v bj fother c43val def
                                                        v 255 ne {
                                                            j 1 add fs fr 2 add 3 mod fcnt 2 add [fvals aload pop 40 v] fput
                                                            j 1 add fother fr 2 add 3 mod fcnt 2 add [fvals aload pop 39 v] fput
                                                        } if
                                                        /v bj 3 c43val def
                                                        v 255 ne {
                                                            j 1 add fs fr 2 add 3 mod fcnt 2 add [fvals aload pop 41 v] fput
                                                        } if
                                                    } if
                                                } if
                                            } {pop} ifelse
                                        } for
                                    } if
                                } if
                            } for
                        } if
                    } forall

                } if

            } for

            %
            % Trace back
            %
            /t dpcost msglen ns mul get dpcost msglen ns mul 1 add get le {0} {1} ifelse def
            /i msglen def
            /evs [
                { % loop
                    dpback i ns mul t add get dup null eq {pop exit} if
                    aload pop /e exch def /t exch def /i exch def
                    e
                } loop
            ] def
            /start gs1 {273} {t 0 eq {256} {272} ifelse} ifelse def

            /pack {  % c43values -> codewords
                [ exch 0 3 2 index length 1 sub {
                    1 index exch 3 getinterval aload pop
                    exch 43 mul add exch 1849 mul add
                    dup 282 idiv exch 282 mod
                    3 -1 roll
                } for pop ]
            } def

            /cws [
                mac06 {270} if
                /vals null def
                evs length 1 sub -1 0 {
                    evs exch get /ev exch def
                    ev 0 get
                    dup 0 eq {pop ev 1 get aload pop} {
                    dup 1 eq {pop ev 1 get /vals [] def} {
                    dup 2 eq {pop /vals [vals aload pop ev 1 get aload pop] def} {
                    dup 3 eq {pop
                        [vals aload pop ev 1 get {42} repeat] pack aload pop
                        ev 2 get {282} if
                        /vals null def
                    } {pop
                        ev 1 get
                        [ev 2 get aload pop ev 3 get ev 2 get length sub {42} repeat] pack aload pop
                    } ifelse
                    } ifelse
                    } ifelse
                    } ifelse
                } for
            ] def

        } ifelse

        /dcws [
            scr aload pop
            scp aload pop
            cws aload pop
        ] def

        (input.encoding.normal) //ultracode.after exec

    } ifelse

    options /debugcws known
    /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledebug known} {pop false} ifelse
    and { /bwipp.debugcws dcws //raiseerror exec } if

    (metrics.selection) //ultracode.before exec

    /mcc dcws length 3 add def  % Message codewords: start mcc acc [dcws ...]

    /qccof {  % eclval -> qcc
        dup 0 ne {
            //ultracode.qccfact exch get mcc 25 idiv mcc 25 mod 0 ne {1 add} if mul 5 add
        } {
            pop 3
        } ifelse
    } def

    /capof {  % rows columns -> capacity in codewords, less the secondary vertical clock tracks
        dup dup 15 ge {1 sub} if
        1 index 31 ge {1 sub} if
        exch 47 ge {1 sub} if
        mul 3 sub
    } def

    /eclval eclevel 2 get 48 sub def
    /tcc mcc eclval qccof add def

    %
    % The first Model that permits the codewords, or the requested rows, with the fewest columns that fit
    %
    /userrows rows def
    /usercols columns def
    /okay false def
    /colsvalid usercols -1 eq def
    //ultracode.metrics {
        /m exch def
        /rows m 0 get def
        /minc m 1 get def  % Least codewords for which the Model is chosen automatically
        /maxc m 2 get def  % Most codewords that the Model permits
        /mcol m 3 get def  % Least columns, from which the DCC is measured
        /maxcol m 4 get def
        userrows -1 eq userrows rows eq or {
            usercols -1 eq {mcol maxcol} {usercols dup} ifelse  % first last
            usercols mcol ge usercols maxcol le and {/colsvalid true def} if
            tcc maxc le
            userrows -1 eq usercols -1 eq and {tcc minc ge and} if
            usercols -1 eq usercols mcol ge usercols maxcol le and or and {
                1 exch {
                    /columns exch def
                    columns 15 ne columns 31 ne and columns 47 ne and {
                        rows columns capof tcc ge {/okay true def exit} if
                    } if
                } for
            } {pop pop} ifelse
        } if
        okay {exit} if
    } forall

    colsvalid not {
        /bwipp.ultracodeInvalidColumns (The columns are not available for the requested rows) //raiseerror exec
    } if
    okay not {
        /bwipp.ultracodeNoValidSymbol (Maximum length exceeded or invalid content) //raiseerror exec
    } if

    %
    % Raise the error correction level to the highest that fits the symbol
    %
    /cap rows columns capof def
    fixedeclevel not rev 2 eq and {
        eclval 1 add 1 5 {
            dup qccof mcc add cap le {/eclval exch def} {pop} ifelse
        } for
    } if

    /qcc eclval qccof def
    /acc qcc 3 sub 78 link1 mul add def
    /tcc mcc qcc add def
    /pads cap tcc sub def
    /dcc columns mcol sub def

    (metrics.selection) //ultracode.after exec

    %
    % Fetch the coefficients
    %
    (ecc.coeffs) //ultracode.before exec
    /n mcc def  /k qcc def
    /coeffs k //ultracode.coeffscachefetch exec def
    (ecc.coeffs) //ultracode.after exec

    (ecc.cws) //ultracode.before exec

    %
    % Reed-Solomon error correction over GF(283). Input is the concatenation
    % [start, mcc, acc, dcws...].
    %
    /rsdata [ start mcc acc dcws aload pop ] def
    /ecws k array def
    {rsdata exch get} n coeffs ecws 283 //rsecprime exec

    options /debugecc known
    /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledebug known} {pop false} ifelse
    and { /bwipp.debugecc ecws //raiseerror exec } if

    (ecc.cws) //ultracode.after exec

    (matrix.layout) //ultracode.before exec

    /dccu rev 1 eq {//ultracode.dccurev1} {//ultracode.dccurev2} ifelse def
    /dccl rev 1 eq {//ultracode.dcclrev1} {//ultracode.dcclrev2} ifelse def

    %
    % Create the bitmap
    %
    /rows rows 6 mul 1 add def
    /columns columns 6 add def
    /pixs [ rows columns mul {-1} repeat ] def
    /qmv {columns mul add} def

    (matrix.layout.fixtures) //ultracode.before exec

    0 1 columns 1 sub {
        /i exch def
        0 6 rows 1 sub {
            /j exch def
            i 5 ge {pixs i j qmv i 2 mod 9 mul put} if
        } for
        pixs i 0 qmv 9 put
        pixs i rows 1 sub qmv 9 put
    } for
    1 1 rows 2 sub {
        /i exch def
        3 16 columns 1 sub {
            /j exch def
            pixs j i qmv 1 i 2 mod sub 9 mul put
        } for
        pixs 0 i qmv 9 put
        pixs 1 i qmv 1 i 2 mod sub 9 mul put
        pixs 2 i qmv 0 put
        pixs 3 i qmv 9 put
        pixs 4 i qmv 0 put
        pixs columns 1 sub i qmv 9 put
    } for

    (matrix.layout.fixtures) //ultracode.after exec

    (matrix.layout.reserve) //ultracode.before exec

    %
    % DCCU and DCCL tiles
    %
    /i rows 2 idiv 5 sub def
    [
        dccu dcc get 10 5 string cvrs {48 sub} forall
        0
        dccl dcc get 10 5 string cvrs {48 sub} forall
    ] {
        pixs 2 i qmv 3 -1 roll put
        /i i 1 add def
    } forall

    (matrix.layout.reserve) //ultracode.after exec

    (matrix.layout.data) //ultracode.before exec

    %
    % Data tiles
    %
    /tileseq [
        start
        mcc
        ecws aload pop
        tcc
        283  % SEP
        acc
        dcws aload pop
        pads {284} repeat
        qcc
    ] def

    /x 5 def /y 1 def
    tileseq {
         //ultracode.tiles exch get 10 5 string cvrs {
              pixs x y qmv 3 -1 roll 48 sub put
              /y y 1 add def
         } forall
         y rows 1 sub ne {
              /y y 1 add def      % Jump horizontal timing pattern
         } {
              /x x 1 add def  /y 1 def
              pixs x y qmv get -1 ne {
                  /x x 1 add def  % Jump vertical timing pattern
              } if
         } ifelse
    } forall

    (matrix.layout.data) //ultracode.after exec

    (matrix.layout) //ultracode.after exec

    <<
    /ren /renmatrix
    /pixs pixs
    /pixx columns
    /pixy rows
    /height rows modunit mul 72 div
    /width columns modunit mul 72 div
    /colormap //ultracode.colormap
    /borderleft 1.0
    /borderright 1.0
    /bordertop 1.0
    /borderbottom 1.0
    /strictspec strictspec
    /loosespec loosespec
    /xdim xdim
    /xmin xmin
    /xmax xmax
    /modunit modunit
    /opt options
    >>

    _render //renmatrix if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/ultracode dup load executeonly /uk.co.terryburton.bwipp defineresource pop
(setup.define) //ultracode.after exec
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER ultracode--
