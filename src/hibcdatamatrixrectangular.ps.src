% --BEGIN ENCODER hibcdatamatrixrectangular--
% --REQUIRES preamble raiseerror setuphooks processoptions parseinput hibcprocess setanycolor fifocache rsecbinary render renmatrix datamatrix--
% --DESC: HIBC Data Matrix Rectangular
% --EXAM: A999BJC5D6E71
% --EXOP:
% --RNDR: renmatrix
% --FMLY: Pharmaceutical Symbols
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
8 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /hibcprocess dup /uk.co.terryburton.bwipp findresource put
dup /renmatrix dup /uk.co.terryburton.bwipp findresource put
dup /datamatrix dup /uk.co.terryburton.bwipp findresource put
begin

/hibcdatamatrixrectangular {

    8 dict begin
    {

    /dontdraw false def
    /validatecheck false def
    /dontlint false def

    {null /apply //processoptions exec} stopped {pop stop} if
    /options exch def
    /barcode exch def

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    %
    % Validate the input
    %
    barcode () eq {
        /bwipp.hibcdatamatrixrectangularEmptyData (The data must not be empty) //raiseerror exec
    } if

    barcode length 15000 gt {
        /bwipp.hibcdatamatrixrectangularinputTooLong (The input data is too long) //raiseerror exec
    } if

    barcode validatecheck dontlint //hibcprocess exec /barcode exch def

    %
    % Get the result of encoding with datamatrix
    %
    options (validatecheck) false put
    options (format) (rectangle) put

    /uk.co.terryburton.bwipp._dontdraw true def
    barcode options //datamatrix exec /args exch def

    args (opt) options put
    args

    _render //renmatrix if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/hibcdatamatrixrectangular dup load executeonly /uk.co.terryburton.bwipp defineresource pop
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER hibcdatamatrixrectangular--
