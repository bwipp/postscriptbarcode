% --BEGIN ENCODER code128--
% --REQUIRES preamble raiseerror setuphooks processoptions parseinput setanycolor render renlinear--
% --DESC: Code 128
% --EXAM: Count01234567!
% --EXOP: includetext
% --RNDR: renlinear
% --FMLY: One-dimensional symbols
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
65 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /parseinput dup /uk.co.terryburton.bwipp findresource put
dup /render dup /uk.co.terryburton.bwipp findresource put
dup /renlinear dup /uk.co.terryburton.bwipp findresource put
begin

%
% Special function characters
%
/code128.fn1  -7 def  /code128.fn2  -8 def  /code128.fn3  -9 def
/code128.stp -12 def
/code128.lka -13 def  /code128.lkc -14 def  % CC-A/B and CC-C linkage
/code128.fna -15 def  % FNC1 in second position, after an AIM application indicator

/fn1 //code128.fn1 def  /fn2 //code128.fn2 def  /fn3 //code128.fn3 def
/stp //code128.stp def
/lka //code128.lka def  /lkc //code128.lkc def

%
% State machine constants
%
% - Encoder states are named A0, B0, C0, A1, B1, and C1.
% - A, B, and C are the Code 128 code sets.
% - 0 is for ASCII and 1 is for extended ASCII range.
%
% Strings are a convenient way of defining latch sequences. The strings map to
% Code 128 instructions.
%
% The encoder never latches between C0 and C1 directly, changing the extended
% range only in code set A or B.
%

% Prior state:      A0    B0    C0     A1    B1    C1
/code128.latch_a0 [ ()    (e)   (e)    (ee)  (eee) (eee)  ] readonly def
/code128.latch_b0 [ (d)   ()    (d)    (ddd) (dd)  (ddd)  ] readonly def
/code128.latch_c0 [ (c)   (c)   ()     (eec) (ddc) (dddc) ] readonly def
/code128.latch_a1 [ (ee)  (eee) (eee)  ()    (e)   (e)    ] readonly def
/code128.latch_b1 [ (ddd) (dd)  (ddd)  (d)   ()    (d)    ] readonly def
/code128.latch_c1 [ (eec) (ddc) (dddc) (c)   (c)   ()     ] readonly def

/code128.latch_sequence [ code128.latch_a0 code128.latch_b0 code128.latch_c0 code128.latch_a1 code128.latch_b1 code128.latch_c1 ] readonly def
/code128.start_code     [ 103 104 105 ] readonly def

% Cost of each byte in states A0, B0, A1 and B1, including any FNC4 and Shift, in units of 8
/code128.cost_ab [
    [ 0 1 3 4 ] {
        256 string exch
        0 1 255 {
            8 1 index 128 ge 3 index 3 ge ne {8 add} if
            1 index 127 and 3 index 3 mod 0 eq {96 ge} {32 lt} ifelse {8 add} if
            3 index 3 1 roll put
        } for
        pop readonly
    } forall
] readonly def

/code128.unavailable 16#4000000 def  % Exceeds the cost of any symbol

%
% Character sets - map special function characters to codewords
%
/code128.seta << fn3 96  fn2 97  fn1 102  stp 106  lka 100  lkc  99 >> readonly def
/code128.setb << fn3 96  fn2 97  fn1 102  stp 106  lka  99  lkc 101 >> readonly def
/code128.setc <<                 fn1 102  stp 106  lka 101  lkc 100 >> readonly def

%
% Create an array containing the character mappings
%
/code128.encs [
    (212222) (222122) (222221) (121223) (121322) (131222) (122213)
    (122312) (132212) (221213) (221312) (231212) (112232) (122132)
    (122231) (113222) (123122) (123221) (223211) (221132) (221231)
    (213212) (223112) (312131) (311222) (321122) (321221) (312212)
    (322112) (322211) (212123) (212321) (232121) (111323) (131123)
    (131321) (112313) (132113) (132311) (211313) (231113) (231311)
    (112133) (112331) (132131) (113123) (113321) (133121) (313121)
    (211331) (231131) (213113) (213311) (213131) (311123) (311321)
    (331121) (312113) (312311) (332111) (314111) (221411) (431111)
    (111224) (111422) (121124) (121421) (141122) (141221) (112214)
    (112412) (122114) (122411) (142112) (142211) (241211) (221114)
    (413111) (241112) (134111) (111242) (121142) (121241) (114212)
    (124112) (124211) (411212) (421112) (421211) (212141) (214121)
    (412121) (111143) (111341) (131141) (114113) (114311) (411113)
    (411311) (113141) (114131) (311141) (411131) (211412) (211214)
    (211232) (2331112)
] readonly def

/code128 {

    64 dict begin
    {

    /dontdraw false def
    /includetext false def
    /text1font /Courier def
    /text1size 10.0 def
    /text1xoffset 0.0 def
    /text1yoffset -7.0 def
    /height -1.0 def
    /width 0 def
    /raw false def
    /parse false def
    /parsefnc false def
    /readerinit false def
    /suppressc false def          % Suppress code set C
    /unlatchextbeforec false def  % Suppress extended ASCII with code set C

    /propspec false def
    /loosespec false def
    /strictspec false def
    /mag 1.0 def
    /xdim -1.0 def
    /hdim -1.0 def
    /ast (default) def
    /xmin -1.0 def  /xnom -1.0 def  /xmax -1.0 def
    /hnom -1.0 def
    /modunit 1 def

    null /apply //processoptions exec /options exch def
    /global_encoder_defaults //render exec

    /barcode exch def

    barcode length 500 gt {
        /bwipp.code128inputTooLong (The input data is too long) //raiseerror exec
    } if

    %
    % Apply AST spec overrides and resolve physical specification
    %
    /code128 ast /apply_ast //render exec not { //raiseerror exec } if
    /resolve_strictspec //render exec

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    %
    % Parse the input
    %
    /fncvals <<
        /parse parse
        /parsefnc parsefnc
        (FNC1) //code128.fn1
        (FNC2) //code128.fn2
        (FNC3) //code128.fn3
%        (FNC4)        Not user accessible as encoded automatically
        (LNKA) //code128.lka
        (LNKC) //code128.lkc
        (FNC@) //code128.fna
    >> def
    barcode fncvals //parseinput exec /msg exch def
    /msglen msg length def

    %
    % Reader initialisation leads with FNC3. Readers do not transmit the data, so FNC1 in first
    % or second position would declare a format that is never received
    %
    readerinit {
        raw {
            /bwipp.code128ReaderinitRaw (Reader initialisation is not available with raw codewords, which can include FNC3 directly) //raiseerror exec
        } if
        msglen 0 gt { msg 0 get dup //code128.fn1 eq exch //code128.fna eq or } { false } ifelse {
            /bwipp.code128ReaderinitFNC1 (Reader initialisation is not available with FNC1 in first or second position) //raiseerror exec
        } if
        /msg msglen 1 add array dup 0 //code128.fn3 put dup 1 msg putinterval def
        /msglen msg length def
    } if

    %
    % FNC1 in second position follows an AIM application indicator of one letter or two digits
    %
    /fnc1second msglen 0 gt { msg 0 get //code128.fna eq } { false } ifelse def
    fnc1second {
        /appindlen msg 1 get dup 48 ge exch 57 le and { 2 } { 1 } ifelse def
        /msg [
            msg 1 appindlen getinterval aload pop
            //code128.fn1
            msg appindlen 1 add msglen appindlen sub 1 sub getinterval aload pop
        ] def
    } {
        /appindlen -1 def
    } ifelse

    %
    % An FNC1 written after two leading digits is also in second position, unless code set C
    % is suppressed
    %
    fnc1second not suppressc not and msglen 3 ge and {
        msg 0 get dup 48 ge exch 57 le and
        msg 1 get dup 48 ge exch 57 le and and
        msg 2 get //code128.fn1 eq and { /appindlen 2 def } if
    } if

    parsefnc {  % Function characters only come from parsefnc
        msg {
            //code128.fna eq {
                /bwipp.code128FNC1secondNotFirst (FNC1 in second position must be declared at the start of the data) //raiseerror exec
            } if
        } forall
    } if

    raw {
        /cws barcode length array def
        /i 0 def /j 0 def
        { % loop
            i barcode length 3 sub ge {exit} if
            barcode i get 94 ne {exit} if
            barcode i 1 add 3 getinterval false 1 index {
                dup 48 lt exch 57 gt or { pop true } if
            } forall { pop exit } if
            cvi /cw exch def
            cw 106 gt {
                /bwipp.code128BadRawCodeword (Raw codewords must be 0 to 106) //raiseerror exec
            } if
            cws j cw put
            /i i 4 add def
            /j j 1 add def
        } loop
        i barcode length ne j 0 eq or {
            /bwipp.code128BadRawFormat (Raw codewords must be formatted as ^NNN) //raiseerror exec
        } if
        /cws cws 0 j getinterval def
        /text () def
    } {
        /text msglen string def
        0 1 msglen 1 sub {
            /i exch def
            text i msg i get dup 0 lt { pop 32 } if put
        } for
        readerinit {  % The leading FNC3 is not shown
            /text text 1 msglen 1 sub getinterval def
        } if
        fnc1second {  % FNC1 in second position is not shown
            msglen 1 sub string
            dup 0 text 0 appindlen getinterval putinterval
            dup appindlen text appindlen 1 add msglen appindlen sub 1 sub getinterval putinterval
            /text exch def
        } if
    } ifelse

    raw not {

        %
        % Character sets for special function characters
        %
        /seta //code128.seta def
        /setb //code128.setb def
        /setc //code128.setc def

        %
        % Shortest encodation over the states A0, B0, C0, A1, B1 and C1 (see the
        % static tables). The cost from each position to the end is found for
        % each prior state, resolving ties by preferring the earlier of the states
        % in a priority order that depends on the data.
        %
        /have_a false def  /have_b false def  /have_c false def  /have_ext false def  /have_fnc1 false def
        false msg {
            dup //code128.fn1 eq {/have_fnc1 true def} if
            dup 0 ge {
                dup 128 ge {/have_ext true def} if
                dup 96 and dup 0 eq {/have_a true def} if 96 eq {/have_b true def} if
                dup 48 ge exch 57 le and
                dup 3 -1 roll and {/have_c true def} if
            } {
                pop pop false
            } ifelse
        } forall
        pop
        have_fnc1 {/have_a true def /have_b true def /have_c true def} if
        suppressc {/have_c false def} if

        % Priority order, then the rank of each state within it in the low bits of each cost
        /byprio [
            have_c {2} if  have_b have_a not or {1} if  have_a {0} if
            have_ext {
                have_c unlatchextbeforec not and {5} if  have_b have_a not or {4} if  have_a {3} if
            } if
        ] def
        /rank [ 6 {//code128.unavailable} repeat ] def
        0 1 byprio length 1 sub { rank byprio 2 index get 3 -1 roll put } for
        /byprio [ byprio aload pop byprio length 1 7 { pop 2 } for ] def  % Rank 7 is a required code set C

        %
        % Positions of an AIM application indicator and the FNC1 that follows it, which
        % are the first two symbol characters: a letter in code set B, or two digits in
        % code set C
        %
        /rank_appind [ 6 {//code128.unavailable} repeat ] def
        appindlen 1 eq {rank_appind 1 rank 1 get put} if
        appindlen 2 eq {rank_appind 2 7 put} if

        /cost_a0 //code128.cost_ab 0 get def  /cost_b0 //code128.cost_ab 1 get def
        /cost_a1 //code128.cost_ab 2 get def  /cost_b1 //code128.cost_ab 3 get def
        /rank_a0 rank 0 get def  /rank_b0 rank 1 get def  /rank_c0 rank 2 get def
        /rank_a1 rank 3 get def  /rank_b1 rank 4 get def  /rank_c1 rank 5 get def

        %
        % From the last position to the first, the cost of each state at the position, with
        % its rank, then the cost to the end from each prior state, with the rank of the
        % state that it takes at the position
        %
        /keys msglen 1 add 6 mul array def
        keys msglen 6 mul [ 6 {0} repeat ] putinterval
        /cost 6 array def
        msglen 1 sub -1 0 {
            /i exch def
            /c msg i get def
            /next keys i 1 add 6 mul 6 getinterval def

            % Only the required state for an AIM application indicator and the FNC1 that follows it
            i appindlen eq {
                /rank_a0 rank_appind 0 get def  /rank_b0 rank_appind 1 get def  /rank_c0 rank_appind 2 get def
                /rank_a1 rank_appind 3 get def  /rank_b1 rank_appind 4 get def  /rank_c1 rank_appind 5 get def
            } if

            c 0 ge {
                cost 0 cost_a0 c get next 0 get -8 and add rank_a0 add put
                cost 1 cost_b0 c get next 1 get -8 and add rank_b0 add put
                cost 3 cost_a1 c get next 3 get -8 and add rank_a1 add put
                cost 4 cost_b1 c get next 4 get -8 and add rank_b1 add put
            } {
                seta c known {8} {//code128.unavailable} ifelse
                cost 0 2 index next 0 get -8 and add rank_a0 add put
                cost 1 2 index next 1 get -8 and add rank_b0 add put
                cost 3 2 index next 3 get -8 and add rank_a1 add put
                cost 4 2 index next 4 get -8 and add rank_b1 add put
                pop
            } ifelse

            % Code set C takes a pair of digits, or an FNC1 other than after a leading letter
            c 48 ge c 57 le and i 1 add msglen lt and {msg i 1 add get dup 48 ge exch 57 le and} {false} ifelse {
                keys i 2 add 6 mul 6 getinterval
            } {
                c 0 lt {
                    setc c known
                    c //code128.fn1 eq i 1 eq and {
                        msg 0 get dup 65 ge exch 122 le and msg 0 get dup 91 ge exch 96 le and not and not and
                    } if
                } {false} ifelse
                {next} {null} ifelse
            } ifelse
            dup null ne {
                cost 2 2 index 2 get -8 and 8 add rank_c0 add put
                cost 5 3 -1 roll 5 get -8 and 8 add rank_c1 add put
            } {
                pop
                cost 2 //code128.unavailable put
                cost 5 //code128.unavailable put
            } ifelse

            %
            % Cost to the end from each prior state. Per the latch sequences, changing code set
            % costs one and toggling the extended range costs two, in code set A or B. Taking a
            % minimum over a range admits only candidates that exceed another for the same
            % state, so it decides nothing.
            %
            cost aload pop                                      % A0 B0 C0 A1 B1 C1
            5 index 5 index 2 copy gt {exch} if pop             % AB0
            dup 5 index 2 copy gt {exch} if pop                 % ABC0
            4 index 4 index 2 copy gt {exch} if pop             % AB1
            dup 4 index 2 copy gt {exch} if pop                 % ABC1
            9 index                                             % A0: A0, ABC0+1, A1+2, ABC1+3
                3 index  8 add 2 copy gt {exch} if pop
                7 index 16 add 2 copy gt {exch} if pop
                1 index 24 add 2 copy gt {exch} if pop
                11 1 roll
            8 index                                             % B0: B0, ABC0+1, B1+2, ABC1+3
                3 index  8 add 2 copy gt {exch} if pop
                6 index 16 add 2 copy gt {exch} if pop
                1 index 24 add 2 copy gt {exch} if pop
                11 1 roll
            7 index                                             % C0: C0, AB0+1, AB1+3
                4 index  8 add 2 copy gt {exch} if pop
                2 index 24 add 2 copy gt {exch} if pop
                11 1 roll
            6 index                                             % A1: A1, ABC1+1, A0+2, ABC0+3
                1 index  8 add 2 copy gt {exch} if pop
               10 index 16 add 2 copy gt {exch} if pop
                3 index 24 add 2 copy gt {exch} if pop
                11 1 roll
            5 index                                             % B1: B1, ABC1+1, B0+2, ABC0+3
                1 index  8 add 2 copy gt {exch} if pop
                9 index 16 add 2 copy gt {exch} if pop
                3 index 24 add 2 copy gt {exch} if pop
                11 1 roll
            4 index                                             % C1: C1, AB1+1, AB0+3
                2 index  8 add 2 copy gt {exch} if pop
                4 index 24 add 2 copy gt {exch} if pop
                11 1 roll
            10 {pop} repeat
            keys i 6 mul 6 getinterval astore pop
        } for

        %
        % Forwards from the start, the state at each position for the state before it
        %
        mark
        /i 0 def
        msglen 0 eq {
            /state 1 def
        } {
            cost aload pop pop                                  % A0 B0 C0 A1 B1
            24 add exch 24 add 2 copy gt {exch} if pop
            exch 8 add 2 copy gt {exch} if pop
            exch 8 add 2 copy gt {exch} if pop
            exch 8 add 2 copy gt {exch} if pop
            7 and byprio exch get /state exch def
        } ifelse
        //code128.start_code state 3 mod get
        //code128.latch_sequence state get state 3 mod get {} forall
        msglen 0 gt {{  % loop
            /c msg i get def
            state 2 eq state 5 eq or c 0 ge and {
                c 48 sub 10 mul msg i 1 add get 48 sub add
                /i i 2 add def
            } {
                c 0 lt {
                    [ seta setb setc seta setb setc ] state get c get
                } {
                    state 1 eq state 4 eq or {
                        c 128 ge state 4 eq ne {100} if
                        c 127 and 32 lt {98} if
                    } {
                        c 128 ge state 3 eq ne {101} if
                        c 127 and 96 ge {98} if
                    } ifelse
                    c 127 and dup 32 lt {64 add} {32 sub} ifelse
                } ifelse
                /i i 1 add def
            } ifelse
            i msglen ge {exit} if
            /prior state def
            /state byprio keys i 6 mul prior add get 7 and get def
            //code128.latch_sequence state get prior get {} forall
        } loop} if
        counttomark array astore exch pop
        /cws exch def

    } if

    %
    % Derive checksum and place stop character
    %
    /j cws length def
    /cws j 2 add array dup 0 cws putinterval def
    /csum cws 0 get def
    1 1 j 1 sub {
        /i exch def
        /csum csum cws i get i mul add def
    } for
    /csum csum 103 mod def
    cws j csum put
    cws j 1 add 106 put  % stp

    options /debugcws known
    /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledebug known} {pop false} ifelse
    and { /bwipp.debugcws cws //raiseerror exec } if


    %
    % Derive space bar succession
    %
    /sbs cws length 6 mul 1 add string def
    0 1 cws length 1 sub {
        /i exch def
        sbs i 6 mul //code128.encs cws i get get putinterval
    } for

    /sbs [sbs {48 sub} forall] def

    /resolve_height //render exec dup -1 eq { pop 1.0 } if /height exch def

    <<
    /ren /renlinear
    /sbs sbs
    /bhs [sbs length 1 add 2 idiv {height} repeat]
    /bbs [sbs length 1 add 2 idiv {0} repeat]
    /txt [ [text text1xoffset text1yoffset text1font text1size] ]
    /text1xalign (center)
    /borderleft 10.0
    /borderright 10.0
    /strictspec strictspec
    /loosespec loosespec
    /xdim xdim
    /xmin xmin
    /xmax xmax
    /modunit modunit
    /opt options
    >>

    _render //renlinear if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/code128 dup load executeonly /uk.co.terryburton.bwipp defineresource pop
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER code128--
