% --BEGIN ENCODER hibccode39--
% --REQUIRES preamble raiseerror setuphooks processoptions hibcprocess setanycolor render renlinear code39--
% --DESC: HIBC Code 39
% --EXAM: A999BJC5D6E71
% --EXOP: includetext
% --RNDR: renlinear
% --FMLY: Pharmaceutical Symbols
currentglobal
true setglobal
/setpacking where {pop currentpacking true setpacking} if
8 dict
dup /raiseerror dup /uk.co.terryburton.bwipp findresource put
dup /processoptions dup /uk.co.terryburton.bwipp findresource put
dup /hibcprocess dup /uk.co.terryburton.bwipp findresource put
dup /renlinear dup /uk.co.terryburton.bwipp findresource put
dup /code39 dup /uk.co.terryburton.bwipp findresource put
begin

/hibccode39 {

    16 dict begin
    {

    /dontdraw false def
    /text1font /Courier def
    /text1size 10.0 def
    /text1yoffset -7.0 def
    /text1xoffset 0.0 def
    /validatecheck false def
    /dontlint false def

    null /apply //processoptions exec /options exch def
    /barcode exch def

    /_render
        dontdraw /uk.co.terryburton.bwipp.global_ctx dup where {exch get /enabledontdraw known} {pop false} ifelse and
        /uk.co.terryburton.bwipp._dontdraw dup where {exch get} {pop false} ifelse or not
    def

    barcode () eq {
        /bwipp.hibccode39emptyData (The data must not be empty) //raiseerror exec
    } if

    barcode length 500 gt {
        /bwipp.hibccode39inputTooLong (The input data is too long) //raiseerror exec
    } if

    %
    % Validate the input
    %
    barcode validatecheck dontlint //hibcprocess exec /barcode exch def
    /barlen barcode length 2 sub def

    /text barlen 4 add string def
    text 0 42 put
    text 1 barcode putinterval
    text barlen 2 add barcode barlen 1 add get dup 32 eq {pop 95} if put
    text barlen 3 add 42 put

    %
    % Get the result of encoding with code39
    %
    options (includecheck) false put
    options (validatecheck) false put

    /uk.co.terryburton.bwipp._dontdraw true def
    barcode options //code39 exec /args exch def

    args (txt) [ [text text1xoffset text1yoffset text1font text1size] ] put
    args (text1xalign) (center) put
    args (opt) options put
    args

    _render //renlinear if

    } stopped {end stop} if
    end

}
[/barcode] {null def} forall
bind def
/hibccode39 dup load executeonly /uk.co.terryburton.bwipp defineresource pop
end
/setpacking where {pop setpacking} if
setglobal
% --END ENCODER hibccode39--
