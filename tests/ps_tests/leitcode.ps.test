/leitcode dup /uk.co.terryburton.bwipp findresource cvx def

{ (21348075016401) (dontdraw) leitcode /sbs get
} [ 1 1 1 1 1 2 2 1 1 1 1 1 2 2 2 1 2 1 1 2 1 1 1 2 2 1 1 1 1 2 2 2 1 1 1 2 1 1 1 2 2 1 2 1 1 2 1 1 2 1 2 1 1 2 1 1 2 1 2 2 1 1 1 2 1 2 1 1 2 1 2 1 1 2 2 1 1 1 ] debugIsEqual


%
% Error tests
%

{ (123456789012) (dontdraw) leitcode } /bwipp.leitcodeBadLength isError
{ (123456789012345) (dontdraw) leitcode } /bwipp.leitcodeBadLength isError
{ (2134807501640A) (dontdraw) leitcode } /bwipp.leitcodeBadCharacter isError
{ (21348075016400) (dontdraw) leitcode } /bwipp.leitcodeBadCheckDigit isError


%
% Check digit: the digit expected in the error, and the digit added to a short input
%
{ (21348075016400) (dontdraw) leitcode } [/bwipp.leitcodeBadCheckDigit (Incorrect Deutsche Post Leitcode check digit provided: expected 1, not 0)] isErrorInfo
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (2134807501640) (dontdraw) leitcode pop uk.co.terryburton.bwipp.report /checkdigit get end } (1) isEqual
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (21348075016401) (dontdraw) leitcode pop uk.co.terryburton.bwipp.report /checkdigit known end } false isEqual
