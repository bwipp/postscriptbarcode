%

% ISO/IEC 24724:2011


/databartruncated dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {
    exch { 0 (dontdraw) databartruncated /sbs get } dup 3 -1 roll 0 exch put
    exch isEqual
} def

/er_tmpl {
    exch { 0 (dontdraw) databartruncated /sbs get } dup 3 -1 roll 0 exch put
    exch isError
} def


((01)00012345678905)  % ISO/IEC 24724:2011 Figure 4 GS1 DataBar Truncated symbol, same
    [0 1 1 1 1 1 1 2 1 8 1 2 7 4 1 1 3 2 1 1 2 1 4 1 3 2 1 1 1 1 2 4 1 1 7 3 3 2 2 2 4 1 3 1 1 1 1]
    eq_tmpl

((01)00012345678906)    /bwipp.databartruncatedBadCheckDigit    er_tmpl
()                      /bwipp.databartruncatedBadLength        er_tmpl
((01)000123456789051)   /bwipp.databartruncatedBadLength        er_tmpl
((01)000123456789)      /bwipp.databartruncatedBadLength        er_tmpl
((01)0001234567890A)    /bwipp.databartruncatedBadCharacter     er_tmpl
((02)0001234567890)     /bwipp.databartruncatedBadAI            er_tmpl

% AST bounds: xdim below xmin fails
{ (\(01\)09521234543213) (dontdraw strictspec xdim=0.100) databartruncated } /bwipp.renderXdimTooSmall isError

% propspec smoke test
{ 0 0 moveto (\(01\)09521234543213) (propspec) databartruncated true } true isEqual


%
% Check digit: the digit expected in the error, and the digit added to a short input
%
{ (\(01\)09520123456780) (dontdraw) databartruncated } [/bwipp.databartruncatedBadCheckDigit (Incorrect GS1 DataBar Truncated check digit provided: expected 8, not 0)] isErrorInfo
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (\(01\)0952012345678) (dontdraw) databartruncated pop uk.co.terryburton.bwipp.report /checkdigit get end } (8) isEqual
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (\(01\)09520123456788) (dontdraw) databartruncated pop uk.co.terryburton.bwipp.report /checkdigit known end } false isEqual
