%
% Smoke test: strictspec renders without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 databarlimitedcomposite true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(\(01\)09521234543213|\(21\)abcdefghijklmnopqrst)  (strictspec xdim=0.330)  ok_tmpl

% AST bounds: xdim below xmin fails
{ (\(01\)09521234543213|\(21\)abcdefghijklmnopqrst) (dontdraw strictspec xdim=0.100) databarlimitedcomposite } /bwipp.renderXdimTooSmall isError

% strictspec with SST smoke test
{ 0 0 moveto (\(01\)09521234543213|\(21\)abcdefghijklmnopqrst) (strictspec ast=gs1.sst2) databarlimitedcomposite true } true isEqual

% propspec with SST smoke test
{ 0 0 moveto (\(01\)09521234543213|\(21\)abcdefghijklmnopqrst) (propspec ast=gs1.sst2) databarlimitedcomposite true } true isEqual


%
% loosespec via global_ctx: does not leak to gs1-cc (would error on missing xnom)
