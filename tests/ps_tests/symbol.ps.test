% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

/symbol dup /uk.co.terryburton.bwipp findresource cvx def

{ (fima) (dontdraw) symbol /sbs get
} [ 2.25 2.25 2.25 11.25 2.25 11.25 2.25 2.25 2.25 ] debugIsEqual

% FIM bars are on a 1/16 inch pitch: FIM B is 101101101
{ (fimb) (dontdraw) symbol /sbs get
} [ 2.25 6.75 2.25 2.25 2.25 6.75 2.25 2.25 2.25 6.75 2.25 ] debugIsEqual


% Kodak patch codes are on a 0.04 inch grid of narrow (2) and wide (5) elements
/patch_tmpl {  % name widths
    { 72 mul 25 div } forall 7 array astore
    exch { 0 (dontdraw) symbol /sbs get } dup 3 -1 roll 0 exch put
    exch debugIsEqual
} def
(patch1) [ 5 2 5 2 2 2 2 ] patch_tmpl
(patch2) [ 5 2 2 2 2 2 5 ] patch_tmpl
(patch3) [ 5 2 2 2 5 2 2 ] patch_tmpl
(patch4) [ 2 2 5 2 5 2 2 ] patch_tmpl
(patch6) [ 2 2 2 2 5 2 5 ] patch_tmpl
(patcht) [ 2 2 5 2 2 2 5 ] patch_tmpl

{ (patch2) (dontdraw) symbol /bhs get
} [ 2.5 2.5 2.5 2.5 ] debugIsEqual

%
% Error tests
%

{ 51 string (dontdraw) symbol } /bwipp.symbolinputTooLong isError

{ (unknown) (dontdraw) symbol } /bwipp.symbolUnknownSymbol isError

%
% Smoke test: strictspec renders without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 symbol true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(fima)  (strictspec xdim=0.330)  ok_tmpl
(patcht) ()                       ok_tmpl
