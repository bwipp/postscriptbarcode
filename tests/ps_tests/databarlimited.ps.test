%

% ISO/IEC 24724:2011


/databarlimited dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {
    exch { 0 (dontdraw) databarlimited /sbs get } dup 3 -1 roll 0 exch put
    exch isEqual
} def

/er_tmpl {
    exch { 0 (dontdraw) databarlimited /sbs get } dup 3 -1 roll 0 exch put
    exch isError
} def


((01)15012345678907)  % ISO/IEC 24724:2011 Figure 7 GS1 DataBar Limited, same
    [0 1 1 3 2 2 2 3 2 1 2 1 1 1 1 2 3 1 1 2 1 1 1 1 2 1 1 2 2 1 1 2 1 2 1 1 2 3 2 1 3 2 2 2 2 1 1 5 0]
    eq_tmpl

((01)0009876543210)  % ISO/IEC 24724:2011 Figure F.2 GS1 DataBar Limited, same
    [0 1 1 1 1 1 1 2 1 2 1 2 2 4 2 5 1 1 1 1 2 1 1 2 1 1 2 2 1 1 1 3 1 3 1 1 1 3 1 5 1 2 1 2 1 1 1 5 0]
    eq_tmpl


((01)15012345678908)    /bwipp.databarlimitedBadCheckDigit  er_tmpl
()                      /bwipp.databarlimitedBadLength      er_tmpl
((01)150123456789071)   /bwipp.databarlimitedBadLength      er_tmpl
((01)150123456789)      /bwipp.databarlimitedBadLength      er_tmpl
((01)25012345678907)    /bwipp.databarlimitedBadStartDigit  er_tmpl
((01)1501234567890A)    /bwipp.databarlimitedBadCharacter   er_tmpl
((02)15012345678907)    /bwipp.databarlimitedBadAI          er_tmpl

%
% Smoke test: strictspec renders without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 databarlimited true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(\(01\)09521234543213)  (strictspec xdim=0.330)  ok_tmpl

% AST bounds: xdim below xmin fails
{ (\(01\)09521234543213) (dontdraw strictspec xdim=0.100) databarlimited } /bwipp.renderXdimTooSmall isError

% propspec smoke test
{ 0 0 moveto (\(01\)09521234543213) (propspec) databarlimited true } true isEqual


%
% Check digit: the digit expected in the error, and the digit added to a short input
%
{ (\(01\)09520123456780) (dontdraw) databarlimited } [/bwipp.databarlimitedBadCheckDigit (Incorrect GS1 DataBar Limited check digit provided: expected 8, not 0)] isErrorInfo
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (\(01\)0952012345678) (dontdraw) databarlimited pop uk.co.terryburton.bwipp.report /checkdigit get end } (8) isEqual
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (\(01\)09520123456788) (dontdraw) databarlimited pop uk.co.terryburton.bwipp.report /checkdigit known end } false isEqual
