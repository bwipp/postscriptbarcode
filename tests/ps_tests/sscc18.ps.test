/sscc18 dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {
    exch { 0 (dontdraw) sscc18 /sbs get } dup 3 -1 roll 0 exch put
    exch isEqual
} def

/er_tmpl {
    exch { 0 (dontdraw) sscc18 /sbs get } dup 3 -1 roll 0 exch put
    exch isError
} def


((00)095287654321012346)
    [2 1 1 2 3 2 4 1 1 1 3 1 2 1 2 2 2 2 2 2 1 2 1 3 2 1 3 3 1 1 4 2 1 1 1 2 1 2 1 1 2 4 1 1 2 3 3 1 2 1 3 2 1 2 2 2 2 1 2 2 3 1 2 1 3 1 1 1 3 3 2 1 2 2 1 2 1 3 2 3 3 1 1 1 2]
    eq_tmpl


((00)095287654321012345)  /bwipp.sscc18badCheckDigit  er_tmpl
()                        /bwipp.sscc18badLength      er_tmpl
((00)0952876543210123456) /bwipp.sscc18badLength      er_tmpl
((00)0952876543210123)    /bwipp.sscc18badLength      er_tmpl
((00)0952876543210123A)   /bwipp.sscc18badCharacter   er_tmpl
((01)095287654321012345)  /bwipp.sscc18badAI          er_tmpl


%
% Spec options: the GS1-128 ASTs
%

% gs1.sst5: xdim resolves from xnom; bounds and height from the AST
{
    (\(00\)095287654321012346) (dontdraw strictspec ast=gs1.sst5) sscc18 dup /xdim get exch dup /xmin get exch /xmax get 3 array astore
} [0.495 0.495 0.940] isEqual
{ 0 0 moveto (\(00\)095287654321012346) (strictspec ast=gs1.sst5) sscc18 true } true isEqual

% mag scales the height with the X-dimension, as for GS1-128
{
    (\(00\)095287654321012346) (dontdraw strictspec ast=gs1.sst5 mag=1.5) sscc18 /bhs get 0 get
    (\(00\)095287654321012346) (dontdraw strictspec ast=gs1.sst5 mag=1.5) /gs1-128 /uk.co.terryburton.bwipp findresource exec /bhs get 0 get
    eq
} true isEqual

{ (\(00\)095287654321012346) (dontdraw strictspec ast=gs1.sst1) sscc18 } /bwipp.renderUnknownAST isError
{ (\(00\)095287654321012346) (dontdraw strictspec xdim=0.100) sscc18 } /bwipp.renderXdimTooSmall isError
{ (\(00\)095287654321012346) (dontdraw strictspec ast=gs1.sst5 width=2) sscc18 } /bwipp.renderStrictspecDimOverride isError
{ (\(00\)095287654321012346) (dontdraw strictspec ast=gs1.sst5 height=0.5) sscc18 } /bwipp.renderStrictspecDimOverride isError
{ (\(00\)095287654321012346) (dontdraw ast=gs1.sst5) sscc18 } /bwipp.renderOrphanedAST isError


%
% Check digit: the digit expected in the error
%
{ (\(00\)095287654321012345) (dontdraw) sscc18 } [/bwipp.sscc18badCheckDigit (Incorrect SSCC-18 check digit provided: expected 6, not 5)] isErrorInfo
