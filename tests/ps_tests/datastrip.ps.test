% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

/datastrip dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {
    3 1 roll { 0 0 datastrip /pixs get }
    dup 3 -1 roll 1 exch put      % insert options
    dup 3 -1 roll 0 exch put      % insert data
    isEqual
} def

/ok_tmpl {
    { 0 0 datastrip pop true }
    dup 3 -1 roll 1 exch put
    dup 3 -1 roll 0 exch put
    true isEqual
} def

/er_tmpl {
    3 1 roll { 0 0 datastrip }
    dup 3 -1 roll 1 exch put      % insert options
    dup 3 -1 roll 0 exch put      % insert data
    exch isError
} def

% Pseudo-random bytes, which do not compress
/noise {  % n -> string
    dup string 1 0 1 4 index 1 sub {            % n str v i
        exch 75 mul 74 add 65537 mod            % n str i v
        dup 255 and 3 index 3 index 3 -1 roll put
        exch pop
    } for pop exch pop
} def

%
