% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

% AIM USS Code 93 AIM-BC5-2000


/code93 dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {
    exch { 0 (dontdraw includecheck) code93 /sbs get } dup 3 -1 roll 0 exch put
    exch isEqual
} def


% Non-shifts $/+%

($/+%)
    [1 1 1 1 4 1 3 2 1 1 1 1 1 1 2 1 3 1 1 1 3 1 2 1 2 1 1 1 3 1 1 2 1 1 2 2 1 1 1 2 2 2 1 1 1 1 4 1 1] eq_tmpl


%
% Error tests
%

{ (abc) (dontdraw) code93 } /bwipp.code93BadCharacter isError

{ 501 string (dontdraw) code93 } /bwipp.code93inputTooLong isError

%
% Smoke test: propspec renders without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 code93 true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(THIS IS CODE 93)  (propspec)  ok_tmpl

% strictspec smoke test
{ 0 0 moveto (THIS IS CODE 93) (strictspec xdim=0.330) code93 true } true isEqual

%
% validatecheck: the final two characters are the check characters C and K, which are verified, then encoded as with includecheck
%
{ (TEST93+6) (dontdraw validatecheck) code93 /sbs get } (TEST93) (dontdraw includecheck) code93 /sbs get isEqual
{ (A0D^SFT$F) (dontdraw parsefnc validatecheck) code93 /sbs get } (A0D) (dontdraw includecheck) code93 /sbs get isEqual  % C is a shift character
{ (00) (dontdraw validatecheck) code93 /sbs get } () (dontdraw includecheck) code93 /sbs get isEqual  % Degenerate case with check characters only
{ (TEST93AB) (dontdraw validatecheck) code93 } [/bwipp.code93badCheckCharacters (Incorrect Code 93 check characters provided: expected +6, not AB)] isErrorInfo
{ (A0DAF) (dontdraw validatecheck) code93 } [/bwipp.code93badCheckCharacters (Incorrect Code 93 check characters provided: expected ^SFT$F, not AF)] isErrorInfo
{ (6) (dontdraw validatecheck) code93 } /bwipp.code93tooShort isError
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (TEST93+6) (dontdraw validatecheck) code93 pop uk.co.terryburton.bwipp.report /checkdigit known end } false isEqual
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (TEST93) (dontdraw includecheck) code93 pop uk.co.terryburton.bwipp.report /checkdigit get end } (+6) isEqual
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (A0D) (dontdraw includecheck) code93 pop uk.co.terryburton.bwipp.report /checkdigit get end } (^SFT$F) isEqual  % As it would be given

%
% validatecheck with short inputs raises a BWIPP error or encodes
%

{ () (dontdraw validatecheck) code93 } /bwipp.code93tooShort isError
{ (1) (dontdraw validatecheck) code93 } /bwipp.code93tooShort isError

% FNC1 in second position is not available
{ (^FNC@TABC) (parsefnc dontdraw) code93 } /bwipp.unknownFNC isError
