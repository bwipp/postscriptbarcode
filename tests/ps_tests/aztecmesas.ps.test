(Mesa|Mesa) (host=code93i errorcorrection twosided dontdraw) ok_tmpl
(0000000000|Mesa) (host=code128 sampos=26 samtotal=26 dontdraw) ok_tmpl
(ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZ|Mesa) (host=code128 twosided layers=32 dontdraw) ok_tmpl
(^048^048^048|Mesa) (host=code128 parse sampos=1 samtotal=2 dontdraw) ok_tmpl  % Host of zeros given as ordinals
(|^FNC@99Mesa) (host=code128 parsefnc dontdraw) ok_tmpl  % An empty host transmits nothing before the supplement
{  % Check characters that the Mesa always carries are not reported
    /uk.co.terryburton.bwipp.report 4 dict def
    (AZTEC|Mesa) (host=code93 dontdraw) aztecmesas pop
    uk.co.terryburton.bwipp.report /checkdigit known
    currentdict /uk.co.terryburton.bwipp.report undef
} false isEqual
(AB|Mesa) (host=code128 width=0.5 height=0.5 includetext dontdraw) ok_tmpl  % Renderer options are not for the host

% The X-dimension is that of the host, so the host's specification profile applies
{ (012345678905|Mesa) (host=upca strictspec dontdraw) aztecmesas /xdim get } 0.33 isEqual
{ (012345678905|Mesa) (host=upca ast=gs1.sst2 loosespec dontdraw) aztecmesas /xdim get } 0.66 isEqual

% A symbol of over 65535 modules, which an interpreter may refuse to allocate
{
    {
        505 string 0 1 499 { 1 index exch 65 put } for dup 500 (|Mesa) putinterval
        (host=code39 twosided layers=3 barrier=1 dontdraw) aztecmesas /pixs get length 72297 eq
    } stopped { $error /errorname get /bwipp.aztecmesasSymbolTooLarge eq } if
} true isEqual


