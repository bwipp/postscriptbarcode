% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

% AIM ITS/99-003 International Symbology Specification - Aztec Mesas
%
% Expected values are from an independent model whose layout reproduces every
% symbol figure of the specification.


/aztecmesas dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {  % data options [pixs rowheights]
    3 1 roll {
        mark 0 0 aztecmesas
        dup /pixs get aload pop counttomark -1 roll /rowheights get aload pop
        counttomark array astore exch pop
    }
    dup 3 -1 roll 2 exch put
    dup 3 -1 roll 1 exch put
    exch isEqual
} def

/ok_tmpl {
    exch { 0 0 aztecmesas pop true } dup 3 -1 roll 0 exch put
    dup 3 -1 roll 1 exch put
    true isEqual
} def

/er_tmpl {
    3 1 roll { 0 0 aztecmesas }
    dup 3 -1 roll 1 exch put
    dup 3 -1 roll 0 exch put
    exch isError
} def


