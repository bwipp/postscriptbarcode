% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2024 Terry Burton
%

% ISO/IEC 15417:2007


/code128 dup /uk.co.terryburton.bwipp findresource cvx def


% TODO Remove once legacy encoder is purged
{  % Allow for FNC4 immediately after CodeC sequence (cf https://github.com/woo-j/OkapiBarcode/commit/9ce6dccbab20d1190090585ddf91a7f549f4fac9)
    (^193^193^193^193^193^19399999999999999^193) (debugcws parse) code128
} [104 100 100 33 33 33 33 33 33 100 100 99 99 99 99 99 99 99 99 100 100 33 3 106] debugIsEqual

   % Option "unlatchextbeforec" suppresses extended range with character set C (for reader compatibility perhaps?)
{  % Allow for FNC4 immediately after CodeC sequence (cf https://github.com/woo-j/OkapiBarcode/commit/9ce6dccbab20d1190090585ddf91a7f549f4fac9)
    (^193^193^193^193^193^19399999999999999^193) (debugcws parse newencoder unlatchextbeforec) code128
} [104 100 100 33 33 33 33 33 33 100 100 99 99 99 99 99 99 99 99 100 100 33 3 106] debugIsEqual

{  % Nothing avoided here...
    (^193^193^193^193^193^19399999999999999^193) (debugcws parse newencoder) code128
} [104 100 100 33 33 33 33 33 33 99 99 99 99 99 99 99 99 100 33 91 106] debugIsEqual

{  % Option "suppressc" suppresses character set C
    (^193^193^193^193^193^19399999999999999^193) (debugcws parse newencoder suppressc) code128
} [104 100 100 33 33 33 33 33 33 100 100 25 25 25 25 25 25 25 25 25 25 25 25 25 25 100 33 1 106] debugIsEqual

{  % Minimize FNC4 insertion
    ( ^160^160^160^160 ^160^160^160^160 ) (debugcws parse parsefnc newencoder) code128
} [104 0 100 100 0 0 0 0 100 0 0 0 0 0 100 0 23 106] debugIsEqual

{  % Minimize FNC4 insertion
    ( ^160^160^160 ^160^160^160 ^160^160^160 ) (debugcws parse parsefnc newencoder) code128
} [104 0 100 100 0 0 0 100 0 0 0 0 100 0 0 0 0 100 0 84 106] debugIsEqual

{  % Minimize FNC4 insertion
    ( ^160^160 ^160^160 ^160^160 ^160^160 ) (debugcws parse parsefnc newencoder) code128
} [104 0 100 100 0 0 100 0 0 0 100 0 0 0 100 0 0 0 100 0 48 106] debugIsEqual

% TODO Remove once legacy encoder is purged
{  % Avoid extraneous CodeC switch (with immediate switch back to CodeA/B) by re-checking digit runlength >= 4 after enca/encb push
    (12^FNC1345^FNC167^FNC18) (debugcws parse parsefnc) code128
} [105 12 102 34 100 21 102 22 23 102 24 49 106] debugIsEqual

{  % Avoid extraneous CodeC switch (with immediate switch back to CodeA/B) by re-checking digit runlength >= 4 after enca/encb push
    (12^FNC1345^FNC167^FNC18) (debugcws parse parsefnc newencoder) code128
} [105 12 102 34 100 21 102 22 23 102 24 49 106] debugIsEqual

{  % Don't switch to C when 2 digits are followed by FNC1 followed by a non-C character (even though that is unreasonable input)
    ( 12^FNC1 ) (debugcws parse parsefnc newencoder) code128
} [104 0 17 18 102 0 85 106] debugIsEqual

{  % Do switch to C when an even number (larger than 1) of digits are followed by FNC1 and then by an odd number of digits (as long as the total number of digits is 6 or more)
    ( 1234^FNC1567) (debugcws parse parsefnc newencoder) code128
} [104 0 99 12 34 102 56 100 23 41 106] debugIsEqual

% TODO Remove once legacy encoder is purged
{  % Don't start in C if A or B would be more efficient
    (123^FNC14567) (debugcws parse parsefnc) code128
} [104 17 99 23 102 45 67 84 106] debugIsEqual

{  % Don't start in C if A or B would be more efficient
    (123^FNC14567) (debugcws parse parsefnc newencoder) code128
} [104 17 99 23 102 45 67 84 106] debugIsEqual


%
%  Test for raw mode
%
{
    (^104^033^034^035^065^066^067^016^017^018^019) (debugcws raw) code128
} [104 33 34 35 65 66 67 16 17 18 19 48 106] debugIsEqual

{ 501 string (dontdraw) code128 } /bwipp.code128inputTooLong isError

% Invalid raw format
{ (^12A) (raw dontdraw) code128 } /bwipp.code128BadRawFormat isError
{ (^12) (raw dontdraw) code128 } /bwipp.code128BadRawFormat isError
{ (^1) (raw dontdraw) code128 } /bwipp.code128BadRawFormat isError
{ (^) (raw dontdraw) code128 } /bwipp.code128BadRawFormat isError
{ (^105garbage) (raw dontdraw) code128 } /bwipp.code128BadRawFormat isError

% Raw codeword out of range (valid: 0-106)
{ (^107) (raw dontdraw) code128 } /bwipp.code128BadRawCodeword isError
{ (^999) (raw dontdraw) code128 } /bwipp.code128BadRawCodeword isError

%
% Smoke test: propspec renders without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 code128 true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(Count01234567!)  (propspec)  ok_tmpl


% strictspec smoke test
{ 0 0 moveto (Count01234567!) (strictspec xdim=0.330) code128 true } true isEqual

% An FNC1 written after an AIM application indicator is encoded as written
{ (T^FNC1ABC) (parsefnc debugcws) code128 } [104 52 102 33 34 35 49 106] debugIsEqual
{ (12^FNC1ABC) (parsefnc debugcws) code128 } [105 12 102 100 33 34 35 0 106] debugIsEqual

% FNC1 in second position: the AIM application indicator and FNC1 are the first two symbol characters
{ (^FNC@TABC) (parsefnc debugcws) code128 } [104 52 102 33 34 35 49 106] debugIsEqual
{ (^FNC@tabc) (parsefnc debugcws) code128 } [104 84 102 65 66 67 53 106] debugIsEqual
{ (^FNC@12abcdefgh) (parsefnc debugcws) code128 } [105 12 102 100 65 66 67 68 69 70 71 72 35 106] debugIsEqual
{ (^FNC@99) (parsefnc debugcws) code128 } [105 99 102 99 106] debugIsEqual
{ (^FNC@12^FNC134) (parsefnc debugcws) code128 } [105 12 102 102 34 42 106] debugIsEqual
{ (^FNC@t^009^010^011) (parse parsefnc debugcws) code128 } [104 84 102 101 73 74 75 56 106] debugIsEqual
{ (^FNC@TABC) (parsefnc newencoder debugcws) code128 } [104 52 102 33 34 35 49 106] debugIsEqual
{ (^FNC@12abcdefgh) (parsefnc newencoder debugcws) code128 } [105 12 102 100 65 66 67 68 69 70 71 72 35 106] debugIsEqual
{ (^FNC@T^009^010^011) (parse parsefnc newencoder debugcws) code128 } [104 52 102 101 73 74 75 24 106] debugIsEqual
{ (^FNC@T^200^201) (parse parsefnc newencoder debugcws) code128 } [104 52 102 100 40 100 41 21 106] debugIsEqual

% Code set C carries an AIM application indicator of two digits, then is suppressed
{ (^FNC@123456) (parsefnc newencoder suppressc debugcws) code128 } [105 12 102 100 19 20 21 22 47 106] debugIsEqual
{ (^FNC@12^FNC134) (parsefnc newencoder suppressc debugcws) code128 } [105 12 102 100 102 19 20 8 106] debugIsEqual

% The FNC1 in second position is not shown
{ (^FNC@TAB^FNC1C) (parsefnc includetext dontdraw) code128 /txt get 0 get 0 get } (TAB C) isEqual

{ (A^FNC@T) (parsefnc dontdraw) code128 } /bwipp.code128FNC1secondNotFirst isError
{ (^FNC@T^FNC@U) (parsefnc dontdraw) code128 } /bwipp.code128FNC1secondNotFirst isError
{ (^FNC@1A) (parsefnc dontdraw) code128 } /bwipp.invalidAIMapplicationIndicator isError
