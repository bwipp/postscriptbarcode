] eq_tmpl

% Structured Append passes through
{
    (1234567890) (sampos=1 samtotal=2 samid=5 debugcws) datamatrixrectangular
} [233 15 1 5 142 164 186 208 220 129] debugIsEqual

% FNC1 in second position passes through to the base encoder
{ (^FNC@T12345^FNC1ABC) (parsefnc debugcws) datamatrixrectangular } [85 232 142 164 54 232 66 67 68 129] debugIsEqual
