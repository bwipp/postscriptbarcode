{ (79-7/22A) (dontdraw rowheight=5) dxfilmedge /rowheights get } [5 5] debugIsEqual

/er_tmpl {
    exch { 0 (dontdraw) dxfilmedge } dup 3 -1 roll 0 exch put
    exch isError
} def

