/dxfilmedge dup /uk.co.terryburton.bwipp findresource cvx def

%
% The clock track above the data track
%
/eq_tmpl {  % data pixs
    exch { 0 (dontdraw) dxfilmedge /pixs get } dup 3 -1 roll 0 exch put
    exch debugIsEqual
} def

