%
% Error tests
%

{ ((01)09501101530003) (linkagea linkagec dontdraw) gs1-128 } /bwipp.gs1128badLinkage isError

{ 501 string (dontdraw) gs1-128 } /bwipp.gs1128inputTooLong isError

% strictspec smoke test
{ 0 0 moveto (\(01\)09521234543213\(3103\)000123) (includetext strictspec xdim=0.330) gs1-128 true } true isEqual

%
% AST bounds (default): xdim below xmin (0.170) fails
%
{ (\(01\)09521234543213) (dontdraw strictspec xdim=0.100) gs1-128 } /bwipp.renderXdimTooSmall isError

%
% AST bounds (default): xdim above xmax (1.016) fails
%
{ (\(01\)09521234543213) (dontdraw strictspec xdim=1.100) gs1-128 } /bwipp.renderXdimTooLarge isError

%
% AST bounds (gs1.sst2): tighter xmin (0.495) applied via wrapper AST
%
{ (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2 xdim=0.330) gs1-128 } /bwipp.renderXdimTooSmall isError

%
% propspec: height derived from sst2 AST hnom/xnom through wrapper
% hnom=31.75 xnom=0.495: round(31.75/0.495)=64, 64/72=0.8889
%
{
    (\(01\)09521234543213) (dontdraw propspec ast=gs1.sst2) gs1-128 /bhs get 0 get 1 array astore
} [0.8889] isEqual

%
% propspec without hnom (default AST): falls back to wrapper height default (0.5)
%
{
    (\(01\)09521234543213) (dontdraw propspec) gs1-128 /bhs get 0 get 1 array astore
} [0.5] isEqual

%
% strictspec with sst2: xdim resolves from xnom (0.495)
%
{
    (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2) gs1-128 dup /strictspec get exch /xdim get 2 array astore
} [true 0.495] isEqual

% propspec + user height with SST: multiplier on derived height
{ (\(01\)09521234543213) (dontdraw propspec ast=gs1.sst2 height=0.3) gs1-128 /bhs get 0 get 1 array astore } [0.2667] isEqual

%
% loosespec: falls back when default AST has no xnom
%
/tmp uk.co.terryburton.bwipp.global_ctx def
/tmp uk.co.terryburton.bwipp.global_ctx def
/uk.co.terryburton.bwipp.global_ctx << /enabledebug true /enabledontdraw true /loosespec true >> def
{ (\(01\)09521234543213\(3103\)000123) (dontdraw) gs1-128 /strictspec get 1 array astore } [false] isEqual
/uk.co.terryburton.bwipp.global_ctx tmp def

%
% loosespec: activates with SST that provides xnom
%
/tmp uk.co.terryburton.bwipp.global_ctx def
/tmp uk.co.terryburton.bwipp.global_ctx def
/uk.co.terryburton.bwipp.global_ctx << /enabledebug true /enabledontdraw true /loosespec true >> def
{ (\(01\)09521234543213\(3103\)000123) (dontdraw ast=gs1.sst2) gs1-128 dup /strictspec get exch /xdim get 2 array astore } [true 0.495] isEqual
/uk.co.terryburton.bwipp.global_ctx tmp def

%
% ast consumed: does not leak to code128
%
{ 0 0 moveto (\(01\)09521234543213\(3103\)000123) (includetext loosespec ast=gs1.sst2) gs1-128 true } true isEqual

% An invalid ordinal in a later AI leaves the stack clean
{ (\(01\)09521234543213\(99\)AB^567) (parse dontdraw) gs1-128 } /bwipp.invalidOrdinal isError

% The quiet zones
{ (\(01\)09521234543213\(3103\)000123) (dontdraw) gs1-128 /borderleft get } 10.0 isEqual
{ (\(01\)09521234543213\(3103\)000123) (dontdraw) gs1-128 /borderright get } 10.0 isEqual
