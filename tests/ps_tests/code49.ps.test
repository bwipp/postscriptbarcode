%
% Error tests
%

% Invalid rows (valid: 2-8)
(TEST) (rows=1 dontdraw) /bwipp.code49badRows er_tmpl
(TEST) (rows=9 dontdraw) /bwipp.code49badRows er_tmpl

% Invalid row height (valid: 8-50)
(TEST) (rowheight=7 dontdraw) /bwipp.code49badRowHeight er_tmpl
(TEST) (rowheight=51 dontdraw) /bwipp.code49badRowHeight er_tmpl

% Invalid separator height (valid: 1-5)
(TEST) (sepheight=0 dontdraw) /bwipp.code49badSepHeight er_tmpl
(TEST) (sepheight=6 dontdraw) /bwipp.code49badSepHeight er_tmpl

% Invalid SAM format
(TEST) (sam=1 dontdraw) /bwipp.code49badSAM er_tmpl
(TEST) (sam=110 dontdraw) /bwipp.code49badSAM er_tmpl

% Invalid character (ASCII > 127)
(^128) (parse dontdraw) /bwipp.code49badCharacter er_tmpl

() (dontdraw) /bwipp.code49emptyData er_tmpl

501 string (dontdraw) /bwipp.code49inputTooLong er_tmpl

% strictspec smoke test
{ 0 0 moveto (MULTIPLE ROWS IN CODE 49) (strictspec xdim=0.330) code49 true } true isEqual

% sampos and samtotal are an alternative to sam
{
  (CODE 49 IS A MULTI-ROW, CONTINUOUS, VARIABLE L) (dontdraw debugcws sampos=1 samtotal=3) code49  % Same as sam=13
} [3 12 24 13 14 38 4 10 9 38 18 28 38 10 38 32 22 30 21 29 18 36 27 36 24 32 43 40 38 12 24 17 23 29 18 23 30 24 30 30 28 43 40 38 31 10 27 21 18 10 11 21 14 38 21 35 31 37 9 14 36 3 45 28] debugIsEqual
{
  (CODE 49 IS A MULTI-ROW, CONTINUOUS, VARIABLE L) (dontdraw debugcws append sampos=1 samtotal=3) code49
} /bwipp.code49samAndAppend isError
(TEST) (sam=23 sampos=2 samtotal=3 dontdraw) /bwipp.code49SAMconflict er_tmpl
(TEST) (sampos=2 dontdraw) /bwipp.code49SAMincomplete er_tmpl
(TEST) (samtotal=3 dontdraw) /bwipp.code49SAMincomplete er_tmpl
(TEST) (sampos=1 samtotal=1 dontdraw) /bwipp.code49BadSAMtotal er_tmpl
(TEST) (sampos=1 samtotal=10 dontdraw) /bwipp.code49BadSAMtotal er_tmpl
(TEST) (sampos=0 samtotal=3 dontdraw) /bwipp.code49BadSAMpos er_tmpl
(TEST) (sampos=4 samtotal=3 dontdraw) /bwipp.code49BadSAMpos er_tmpl

% FNC1 in second position: the AIM application indicator is the first code character, FNC1 the second
{ (^FNC@TABC) (parsefnc debugcws) code49 } [29 45 10 11 12 48 48 7 48 48 39 36 47 39 0 12] debugIsEqual
{ (^FNC@tabc) (parsefnc debugcws) code49 } [29 45 44 10 44 11 44 31 12 48 47 4 24 7 5 0] debugIsEqual
{ (^FNC@T12345678) (parsefnc debugcws) code49 } [29 45 48 5 17 9 14 20 6 48 16 38 17 20 0 47] debugIsEqual
{ (^FNC@TABC) (parsefnc append debugcws) code49 } [29 45 10 11 12 48 48 7 48 48 40 3 3 6 1 2] debugIsEqual
{ (^FNC@99ABC) (parsefnc dontdraw) code49 } /bwipp.code49badAIMapplicationIndicator isError
{ (^FNC@tabc) (parsefnc append dontdraw) code49 } /bwipp.code49badAIMapplicationIndicator isError
{ (^FNC@TABC) (parsefnc sampos=1 samtotal=2 dontdraw) code49 } /bwipp.code49SAMfnc1second isError
{ (A^FNC@TB) (parsefnc dontdraw) code49 } /bwipp.code49FNC1secondNotFirst isError

% A numeric run of 5n+1 digits after alphanumeric data ends with a single digit code character
{ (AB111111) (debugcws) code49 } [10 11 48 4 39 23 1 38 48 48 15 3 31 18 0 16] debugIsEqual
{ (AB11111111111) (dontdraw) code49 pop true } true isEqual

% USS Code 49 Example 1 (numeric encodation), at the start of the data and after alphanumeric data
{ (12345) (debugcws) code49 } [5 17 9 48 48 48 48 27 48 48 13 23 0 13 2 0] debugIsEqual
{ (123456) (debugcws) code49 } [5 17 9 6 48 48 48 34 48 48 36 9 23 41 2 11] debugIsEqual
{ (12345678) (debugcws) code49 } [5 17 9 14 6 48 48 0 48 48 25 42 2 17 2 37] debugIsEqual
{ (123456789) (debugcws) code49 } [5 17 9 46 16 37 48 31 48 48 7 26 9 39 2 32] debugIsEqual
{ (1234567) (debugcws) code49 } [43 45 2 11 39 48 48 40 48 48 33 36 38 6 2 15] debugIsEqual
{ (AB12345) (debugcws) code49 } [10 11 48 5 17 9 48 1 48 48 18 37 48 19 0 22] debugIsEqual
{ (AB123456) (debugcws) code49 } [10 11 48 5 17 9 6 8 48 48 33 2 13 26 0 23] debugIsEqual
{ (AB12345678) (debugcws) code49 } [10 11 48 5 17 9 14 16 6 48 35 18 22 34 0 16] debugIsEqual
{ (AB123456789) (debugcws) code49 } [10 11 48 5 17 9 46 48 16 37 21 48 44 28 0 47] debugIsEqual
{ (AB1234567) (debugcws) code49 } [10 11 48 43 45 2 11 23 39 48 46 48 44 15 0 44] debugIsEqual

% The quiet zones are within the symbol
{ (MULTIPLE ROWS IN CODE 49) (dontdraw) code49 dup /borderleft get exch dup /borderright get exch dup /bordertop get exch /borderbottom get 4 array astore } [0.0 0.0 0.0 0.0] isEqual
{ (MULTIPLE ROWS IN CODE 49) (dontdraw) code49 /pixx get } 81 isEqual
