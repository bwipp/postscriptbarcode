% ANSI/AIM BC6-2000


/code49 dup /uk.co.terryburton.bwipp findresource cvx def

/er_tmpl {
    3 1 roll { 0 0 code49 }
    dup 3 -1 roll 1 exch put
    dup 3 -1 roll 0 exch put
    exch isError
} def


{  % 2.3.1 Regular Alphanumeric Mode
  % Note: the 1st split given in the 2.3.4 example is too long due to the comma shifts so adjusting the splits
  (CODE 49 IS A MULTI-ROW, CONTINUOUS, VARIABLE LE) (dontdraw debugcws) code49
} [12 24 13 14 38 4 9 16 38 18 28 38 10 38 22 45 30 21 29 18 36 27 24 38 32 43 40 38 12 24 23 16 29 18 23 30 24 30 28 35 43 40 38 31 10 27 18 11 10 11 21 14 38 21 14 31 29 40 42 25 37 17 42 36] debugIsEqual

{  % 2.3.2 Append Mode
  (NGTH SYMBOLOGY ENCODING THE FULL ASCII 128-CHARA) (dontdraw debugcws append) code49
} [23 16 29 17 38 28 34 38 22 11 24 21 24 16 34 5 38 14 23 12 24 13 18 44 23 16 38 29 17 14 38 28 15 30 21 21 38 10 28 16 12 18 18 38 1 2 8 48 36 12 17 10 27 10 48 13 8 16 17 34 29 34 43 34] debugIsEqual

{  % 2.3.4 Group Alphanumeric Mode
  % Note: the 1st split given in the 2.3.4 example is too long due to the sam overhead (plus comma shifts) so adjusting the splits
  (CODE 49 IS A MULTI-ROW, CONTINUOUS, VARIABLE L) (dontdraw debugcws sam=13) code49
} [3 12 24 13 14 38 4 10 9 38 18 28 38 10 38 32 22 30 21 29 18 36 27 36 24 32 43 40 38 12 24 17 23 29 18 23 30 24 30 30 28 43 40 38 31 10 27 21 18 10 11 21 14 38 21 35 31 37 9 14 36 3 45 28] debugIsEqual
{
  (ENGTH SYMBOLOGY ENCODING THE FULL ASCII 128-CHAR) (dontdraw debugcws sam=23) code49
} [4 14 23 16 29 17 38 43 28 34 22 11 24 21 24 17 16 34 38 14 23 12 24 14 13 18 23 16 38 29 17 7 14 38 15 30 21 21 38 30 10 28 12 18 18 38 1 27 2 8 36 12 17 10 27 14 7 25 27 14 17 15 45 3] debugIsEqual
{
  (ACTER SET.  EACH ROW CONTAINS 18 BARS.) (dontdraw debugcws sam=33) code49
} [5 10 12 29 14 27 38 37 28 14 29 37 38 38 14 2 10 12 17 38 27 24 32 13 38 12 24 23 29 10 18 7 23 28 38 1 8 38 11 0 10 27 28 37 48 48 48 1 47 5 34 37 37 23 38 25] debugIsEqual

{
  (CODE 49 IS A MULTI-ROW, CONTINUOUS, VARIABLE L) (dontdraw debugcws append sam=13) code49
} /bwipp.code49samAndAppend isError

{  % Too long
  (CODE 49 IS A MULTI-ROW, CONTINUOUS, VARIABLE LE) (dontdraw debugcws sam=13) code49
} /bwipp.code49noValidSymbol isError


