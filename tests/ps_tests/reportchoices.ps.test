% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2026 Terry Burton
%

% The choices that an encoder reports (uk.co.terryburton.bwipp.report) take the
% form of the options that select them: giving them as options again reproduces
% the symbol.

/rep {  % data options encoder -> output report
    20 dict begin
    /enc exch /uk.co.terryburton.bwipp findresource def
    /uk.co.terryburton.bwipp.report 16 dict def
    enc exec
    uk.co.terryburton.bwipp.report
    end
} def

/optdict {  % string -> dict  Each option of the string, as processoptions reads it
    32 dict exch
    {
        dup () eq { pop exit } if
        ( ) search not { () exch null exch } if exch pop  % dict rest token
        dup () eq { pop } {
            (=) search { exch pop } { true exch } ifelse  % dict rest value key
            3 index 3 1 roll exch put
        } ifelse
    } loop
} def

% Reports exactly the given keys, besides samparity and checkdigit, and
% encoding again with the reported values, or overrides, put into the options
% gives the same symbol
/rto {  % data options encoder keys overrides -> bool
    20 dict begin
    /ovr exch def
    /keys exch def
    /enc exch def
    /opts exch def
    /dat exch def
    dat opts enc rep /r exch def /p1 exch /pixs get def
    /ok true def
    r {
        pop /k exch def
        k /samparity ne k /checkdigit ne and {
            false keys { k eq or } forall not { /ok false def } if
        } if
    } forall
    /o2 opts optdict def
    keys {
        /k exch def
        r k known {
            o2 k ovr k known { ovr k get } { r k get } ifelse put
        } {
            /ok false def
        } ifelse
    } forall
    /p2 dat o2 enc rep pop /pixs get def
    ok p1 length p2 length eq and {
        true 0 1 p1 length 1 sub { dup p1 exch get exch p2 exch get ne { pop false } if } for
    } {
        false
    } ifelse
    end
} def

/rt_tmpl {  % data options encoder keys
    4 array astore { null aload pop 0 dict rto } dup 3 -1 roll 0 exch put
    true isEqual
} def

% An altered choice gives a different symbol, so the round trip discriminates
/neg_tmpl {  % data options encoder keys overrides
    5 array astore { null aload pop rto } dup 3 -1 roll 0 exch put
    false isEqual
} def

% The values reported, or /missing
/rv_tmpl {  % data options encoder keys values
    5 1 roll 4 array astore
    {
        null aload pop
        4 1 roll rep exch pop exch
        [ 3 1 roll { 1 index exch 2 copy known { get } { pop pop /missing } ifelse exch } forall pop ]
    } dup 3 -1 roll 0 exch put
    exch isEqual
} def

% A reported string is the encoder's own copy, so altering it alters nothing
/cp_tmpl {  % data options encoder key
    4 array astore
    {
        null aload pop
        20 dict begin
        /k exch def /enc exch def /opts exch def /dat exch def
        dat opts enc rep exch pop k get /v1 exch def
        /saved v1 dup length string copy def
        0 1 v1 length 1 sub { v1 exch 88 put } for
        dat opts enc rep exch pop k get saved eq
        end
    } dup 3 -1 roll 0 exch put
    true isEqual
} def

% QR Code, Micro QR Code and rMQR
(Hello World) (dontdraw) /qrcode [/version /eclevel /mask] rt_tmpl
(Hello World) (dontdraw eclevel=H mask=3) /qrcode [/version /eclevel /mask] rt_tmpl
(Hello World 0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ abcdefghijklmnopqrstuvwxyz) (dontdraw) /qrcode [/version /eclevel /mask] rt_tmpl
(12345) (dontdraw) /microqrcode [/version /eclevel /mask] rt_tmpl
(ABC123) (dontdraw) /microqrcode [/version /eclevel /mask] rt_tmpl
(12345) (dontdraw) /rectangularmicroqrcode [/version /eclevel] rt_tmpl
(\(01\)09521234543213\(10\)ABC123) (dontdraw) /gs1qrcode [/version /eclevel /mask] rt_tmpl

