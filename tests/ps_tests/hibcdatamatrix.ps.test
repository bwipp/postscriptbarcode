%
% Check digit: the digit expected in the error
%
{ (A999BJC5D6E71Z) (dontdraw validatecheck) hibcdatamatrix } [/bwipp.HIBCbadCheckDigit (Incorrect HIBC check character provided: expected ".", not "Z")] isErrorInfo

% Structured Append passes through
{
    (1234567890) (sampos=1 samtotal=2 samid=5 debugcws) hibcdatamatrix
} [233 15 1 5 44 142 164 186 208 220 49 129] debugIsEqual

%
% validatecheck with short inputs raises a BWIPP error or encodes
%

{ (+) (dontdraw validatecheck dontlint) hibcdatamatrix pop true } true isEqual

{ (+) (dontdraw validatecheck) hibcdatamatrix } /bwipp.HIBCbadFlag isError
