% The example of the BR Code manual
(00020104141234567890123426580014BR.GOV.BCB.PIX0136123e4567-e12b-12d1-a456-42665544000027300012BR.COM.OUTRO011001234567895204000053039865406123.455802BR5917NOME DO RECEBEDOR6008BRASILIA61087007490062190515RP12345678-201980390012BR.COM.OUTRO01190123.ABCD.3456.WXYZ6304AD38) (parse dontdraw) ok_tmpl

% Static, with the CRC given
(00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5913CORNER BAKERY6009SPRINGTON630462F0) (parse dontdraw) ok_tmpl

% An amount, tip prompt, postal code and additional data
(00020101021126310015COM.EXAMPLE.PAY010812345678520458125303840540512.505502015802US5913CORNER BAKERY6009SPRINGTON61051234562180108INV-00420702T163045483) (parse dontdraw) ok_tmpl

% A fixed convenience fee
(00020101021126310015COM.EXAMPLE.PAY01081234567852045812530384055020256040.505802US5913CORNER BAKERY6009SPRINGTON63046875) (parse dontdraw) ok_tmpl

% A percentage convenience fee
(00020101021126310015COM.EXAMPLE.PAY01081234567852045812530384055020357043.005802US5913CORNER BAKERY6009SPRINGTON63043D3B) (parse dontdraw) ok_tmpl

% A global network account and an unreserved template
(000201021641111111111111115204581253038405802US5913CORNER BAKERY6009SPRINGTON80200011COM.EXAMPLE0101X6304B80F) (parse dontdraw) ok_tmpl

% An alternate language template in UTF-8, its lengths counting characters
(00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5913CORNER BAKERY6009SPRINGTON64210002ZH0105^232^161^151^232^167^146^233^157^162^229^140^133^229^186^1510202^230^152^165^230^184^1756304EE33) (parse dontdraw) ok_tmpl

% The CRC is appended when it is not given
{ (00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5913CORNER BAKERY6009SPRINGTON) (dontdraw) emvqrcode /pixs get } (00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5913CORNER BAKERY6009SPRINGTON630462F0) (dontdraw) qrcode /pixs get debugIsEqual
% Carets in the data are not parsed by QR Code
{ (00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5915CORNER ^^BAKERY6009SPRINGTON) (parsefnc dontdraw) emvqrcode /pixs get } (00020101021126310015COM.EXAMPLE.PAY0108123456785204581253038405802US5915CORNER ^^BAKERY6009SPRINGTON) (dontdraw) emvqrcode /pixs get debugIsEqual

/er_tmpl {
    3 1 roll { 0 0 emvqrcode }
    dup 3 -1 roll 1 exch put
    dup 3 -1 roll 0 exch put
    exch isError
} def

