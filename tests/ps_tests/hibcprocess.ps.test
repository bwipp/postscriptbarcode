% Character set and check character

(a) /bwipp.HIBCbadCharacter er_tmpl
{ (A123BJC5D6E71F) true false hibcprocess } [/bwipp.HIBCbadCheckDigit (Incorrect HIBC check character provided: expected "G", not "F")] isErrorInfo
{ (A123BJC5D6E71G) true true hibcprocess } (+A123BJC5D6E71G) isEqual

% dontlint

{ (/EW123) false true hibcprocess } (+/EW1234) isEqual
{ () false true hibcprocess } (++) isEqual
{ (a) false true hibcprocess } /bwipp.HIBCbadCharacter isError
