% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

% ANSI/HIBC 2.6-2016 (R2026) Supplier Labeling Standard
% ANSI/HIBC 1.3-2010 Provider Applications Standard


/hibcprocess dup /uk.co.terryburton.bwipp findresource cvx def

/vc_tmpl {  % Data with its check character
    dup length 1 add string dup 0 43 put dup 1 3 index putinterval
    exch { 0 true false hibcprocess } dup 0 4 -1 roll put
    exch isEqual
} def

/ok_tmpl {
    { 0 false false hibcprocess pop true } dup 0 4 -1 roll put
    true isEqual
} def

/er_tmpl {
    exch { 0 false false hibcprocess } dup 0 4 -1 roll put
    exch isError
} def


% Examples from the standards, with their check characters

(A123BJC5D6E71G)                                   vc_tmpl  % SLS 4.3.1
($$52001510X3GD)                                   vc_tmpl  % SLS 4.3.2
(A99912345/$$52001510X33)                          vc_tmpl  % SLS 2.2.1.1
(A99912345/$$52001510X3/16D20111212/S77DEFG457)    vc_tmpl  % SLS 2.3.2
(A99912345/$10X3/16D20111231/14D202001313)         vc_tmpl  % SLS 2.3.2.3
(A99912349/$10X3/16D20111231/14D20200131/Q500Z)    vc_tmpl  % SLS 2.3.2.4
(A123BJC5D6E71/$$52001510X3C)                      vc_tmpl  % SLS 4.3.3
(H123ABC01234567890D)                              vc_tmpl  % SLS C.3
($A1234GU)                                         vc_tmpl  % SLS E1.1
(/ACMRN123456/V2009121908334)                      vc_tmpl  % PAS 1.3
(/EO5232013)                                       vc_tmpl  % PAS 1.3
(/EU720060FF0/O523201W)                            vc_tmpl  % PAS 1.3
(/EU720060FF0/O523201/Z34H159/M9842431340V)        vc_tmpl  % PAS 1.3
(/KN12345A)                                        vc_tmpl  % PAS 1.3
(/LAH123/NC9037)                                   vc_tmpl  % PAS 1.3
(/EAH783B)                                         vc_tmpl  % PAS Appendix B
(/EAH783/Z34H159$)                                 vc_tmpl  % PAS 2.2
(04366GX)                                          vc_tmpl  % SLS 2.5 E1.1
($$0905A1234G/)                                    vc_tmpl  % SLS 2.5 E1.1
($$872404121523G2)                                 vc_tmpl  % SLS 2.5 E1.1
($$9014407A1234G8)                                 vc_tmpl  % SLS 2.5 E1.1
($$848GQ)                                          vc_tmpl  % SLS 2.5 E1.1

