/hibccodablockf dup /uk.co.terryburton.bwipp findresource cvx def


% Input validation

{ () (dontdraw) hibccodablockf
} /bwipp.hibccodablockfEmptyData isError

{ () (dontdraw validatecheck) hibccodablockf
} /bwipp.hibccodablockfEmptyData isError

{ 25001 string (dontdraw) hibccodablockf
} /bwipp.hibccodablockfinputTooLong isError

{ (,) (dontdraw) hibccodablockf
} /bwipp.HIBCbadCharacter isError

{ (A123BJC5D6E71H) (dontdraw validatecheck) hibccodablockf  % Check digit should be 'G'
} /bwipp.HIBCbadCheckDigit isError

{ (/) (dontdraw validatecheck) hibccodablockf  % Check digit should be '+'
} /bwipp.HIBCbadCheckDigit isError


