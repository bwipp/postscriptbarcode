} [ 0.125 0.05 0.05 0.125 0.125 0.05 0.125 0.125 0.05 0.05 0.05 0.05 0.125 0.05 0.125 0.05 0.05 0.05 0.125 0.125 0.05 0.05 0.125 0.05 0.125 0.05 0.05 0.125 0.125 0.05 0.05 0.05 0.125 0.05 0.125 0.05 0.125 0.05 0.05 0.125 0.05 0.05 0.05 0.05 0.125 0.125 0.05 0.125 0.05 0.05 0.125 0.125 ] debugIsEqual


%
% Error tests
%

{ (1234) (dontdraw) postnet } /bwipp.postnetBadLength isError
{ (123456) (dontdraw) postnet } /bwipp.postnetBadLength isError
{ (0123A) (dontdraw) postnet } /bwipp.postnetBadCharacter isError
{ (012341) (validatecheck dontdraw) postnet } /bwipp.postnetBadCheckDigit isError


%
% Smoke test: propspec and strictspec render without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 postnet true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(01234)  (includetext propspec)   ok_tmpl
(01234)  (includetext strictspec xdim=0.330)   ok_tmpl


%
% Check digit: the digit expected in the error
%
{ (012345) (dontdraw validatecheck) postnet } [/bwipp.postnetBadCheckDigit (Incorrect USPS POSTNET check digit provided: expected 0, not 5)] isErrorInfo

%
% validatecheck with short inputs raises a BWIPP error or encodes
%

{ () (dontdraw validatecheck) postnet } /bwipp.postnetBadLength isError
{ (0) (dontdraw validatecheck) postnet } /bwipp.postnetBadLength isError
{ (1) (dontdraw validatecheck) postnet } /bwipp.postnetBadLength isError
