% Error correction level 2 for version 1 holds 11 bytes
{ (\200\200\200\200\200\200\200\200\200\200\200) (version=1 eclevel=2 dontdraw) gridmatrix /pixx get } 18 isEqual

% Error correction level 1 is not available in version 1
{ (A) (eclevel=1 dontdraw) gridmatrix /pixx get } 30 isEqual

% Layer ID numbers: 3 at the centre for level 1, 0 for level 5
{ 1143 { pop 16#80 } filled (eclevel=1 dontdraw) gridmatrix dup /pixs get exch /pixx get centrelid } 3 isEqual

