%
% c40headerlength FNC1 in 1st position
%

% FNC1 in 1st position must be in ASCII
{ ((400)123(420)1) (debugcws c40headerlength=10 format=rectangle) gs1datamatrix } [
    232      % FNC1
    230      % lC40
    50 165   % 400
    32 56    % 123
    10 129   % shift2 FNC1 4
    38 38    % 201
] debugIsEqual

{ ((400)123(420)1) (debugcws c40headerlength=10 format=rectangle gssep) gs1datamatrix } [
    232      % FNC1
    230      % lC40
    50 165   % 400
    32 56    % 123
    4 145    % shift1 GS 4
    38 38    % 201
] debugIsEqual

% Unlatches after '123' due to c40headerlength compensation for FNC1 (otherwise would unlatch after '400')
{ ((400)123(420)1) (debugcws c40headerlength=4 format=rectangle) gs1datamatrix } [
    232      % FNC1
    230      % lC40
    50 165   % 400
    32 56    % 123
    254      % unlatch
    232      % FNC1
    172      % 42+130
    131      % 01+130
] debugIsEqual

{ ((400)123(420)1) (debugcws c40headerlength=3 format=rectangle) gs1datamatrix } [
    232      % FNC1
    230      % lC40
    50 165   % 400
    254      % unlatch
    142      % 12+130
    52       % '3'+1
    232      % FNC1
    172      % 42+130
    131      % 01+130
] debugIsEqual

% strictspec smoke test
{ 0 0 moveto (\(01\)09521234543213\(17\)120508\(10\)ABCD1234\(410\)9501101020917) (strictspec xdim=0.330) gs1datamatrix true } true isEqual

%
% AST bounds (default): xdim below xmin (0.100) fails
%
{ (\(01\)09521234543213) (dontdraw strictspec xdim=0.050) gs1datamatrix } /bwipp.renderXdimTooSmall isError

%
% AST bounds (default): xdim above xmax (3.500) fails
%
{ (\(01\)09521234543213) (dontdraw strictspec xdim=4.000) gs1datamatrix } /bwipp.renderXdimTooLarge isError

%
% AST bounds (gs1.sst1): tighter xmin (0.396) applied via wrapper AST
%
{ (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst1 xdim=0.200) gs1datamatrix } /bwipp.renderXdimTooSmall isError

%
% strictspec with sst1: xdim resolves from xnom (0.495) through wrapper AST
%
{
    (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst1) gs1datamatrix dup /strictspec get exch /xdim get 2 array astore
} [true 0.495] isEqual

