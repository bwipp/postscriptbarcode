% Copyright (c) 2004-2026 Terry Burton
%

%
% Tests for the deflate helper, which produces the zlib format (RFC 1950)
% wrapping one DEFLATE (RFC 1951) block. Each expected stream was checked to
% inflate to its input with zlib.
%

/deflate dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {  % input expected
    exch { 0 deflate } dup 3 -1 roll 0 exch put
    exch debugIsEqual
} def

% Empty input: a fixed Huffman block holding only end of block
() <7801030000000001> eq_tmpl

% A single literal
(A) <780173040000420042> eq_tmpl

% Three literals, the shortest input that enters the match search
(ABC) <78017374720600018D00C7> eq_tmpl

% Repeated text becomes literals and a match
(ABCABCABCABCABCABCABCABC) <7801737472C68A004D600631> eq_tmpl

% A run of one byte is matched at a distance of one
300 string 0 1 299 { 1 index exch 97 put } for
<78014B1C05440300D8A871AD> eq_tmpl

% A match is deferred when the next position has a longer one: a literal and
% a match of five, rather than a match of three and three literals
(abc.bcdef.abcdef) <78014B4C4AD64B4A4E494DD34B045300307605CC> eq_tmpl

% A run longer than the longest match is a match of the longest length, then
% the remainder
261 string 0 1 260 { 1 index exch 97 put } for
<78014B1C058989009F2262E6> eq_tmpl

% A repeat 300 bytes back uses a distance code with extra bits
