% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

/cepnet dup /uk.co.terryburton.bwipp findresource cvx def

%
% The example of the Correios guide, whose check digit is 7
%
{ (28107023) (dontdraw) cepnet /bhs get
} [ 0.125 0.05 0.05 0.125 0.05 0.125 0.125 0.05 0.05 0.125 0.05 0.05 0.05 0.05 0.125 0.125 0.125 0.125 0.05 0.05 0.05 0.125 0.05 0.05 0.05 0.125 0.125 0.125 0.05 0.05 0.05 0.05 0.05 0.125 0.05 0.125 0.05 0.05 0.125 0.125 0.05 0.125 0.05 0.05 0.05 0.125 0.125 ] debugIsEqual

{ (281070237) (dontdraw validatecheck) cepnet /bhs get length } 47 isEqual
{ (28107023) (dontdraw includetext includecheckintext) cepnet /txt get 0 get 0 get } (281070237) isEqual
{ (28107023) (dontdraw includetext) cepnet /txt get 0 get 0 get } (28107023) isEqual


%
% Error tests
%

{ (2810702) (dontdraw) cepnet } /bwipp.cepnetBadLength isError
{ (281070237) (dontdraw) cepnet } /bwipp.cepnetBadLength isError
{ (01234) (dontdraw) cepnet } /bwipp.cepnetBadLength isError
{ (2810702A) (dontdraw) cepnet } /bwipp.cepnetBadCharacter isError
{ (281070231) (validatecheck dontdraw) cepnet } [/bwipp.cepnetBadCheckDigit (Incorrect CEPNet check digit provided: expected 7, not 1)] isErrorInfo


%
% Smoke test: propspec and strictspec render without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 cepnet true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(28107023)  (includetext propspec)   ok_tmpl
(28107023)  (includetext strictspec xdim=0.508)   ok_tmpl

%
% Bars and spaces in points, or in modules of xdim under a spec mode
%
{ (28107023) (dontdraw) cepnet /sbs get 0 3 getinterval } [1.44 1.872 1.44] isEqual
{ (28107023) (dontdraw strictspec) cepnet /sbs get 0 3 getinterval } [1 1.3 1] isEqual
{ (28107023) (dontdraw propspec) cepnet /sbs get 0 3 getinterval } [1 1.3 1] isEqual

%
% Tall bars of 0.125 inches, or derived from the AST: hnom=3.175 xnom=0.508,
% round(6.25)=6 modules under propspec
%
{ (28107023) (dontdraw) cepnet /bhs get 0 get } 0.125 isEqual
{ (28107023) (dontdraw propspec) cepnet /bhs get 0 get 72 mul round cvi } 6 isEqual
