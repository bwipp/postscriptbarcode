/ean14 dup /uk.co.terryburton.bwipp findresource cvx def

/eq_tmpl {
    exch { 0 (dontdraw) ean14 /sbs get } dup 3 -1 roll 0 exch put
    exch isEqual
} def

/er_tmpl {
    exch { 0 (dontdraw) ean14 /sbs get } dup 3 -1 roll 0 exch put
    exch isError
} def


((01)09528765432108)
    [2 1 1 2 3 2 4 1 1 1 3 1 2 2 2 1 2 2 2 2 1 2 1 3 2 1 3 3 1 1 4 2 1 1 1 2 1 2 1 1 2 4 1 1 2 3 3 1 2 1 3 2 1 2 1 3 2 2 1 2 3 3 2 1 1 1 2 3 3 1 1 1 2]
    eq_tmpl


((01)09528765432107)    /bwipp.ean14badCheckDigit  er_tmpl
()                      /bwipp.ean14badLength      er_tmpl
((01)095287654321081)   /bwipp.ean14badLength      er_tmpl
((01)095287654321)      /bwipp.ean14badLength      er_tmpl
((01)0952876543210A)    /bwipp.ean14badCharacter   er_tmpl
((02)0952876543210)     /bwipp.ean14badAI          er_tmpl


%
% Spec options: the GS1-128 ASTs
%

% gs1.sst2: xdim resolves from xnom; bounds and height from the AST
{
    (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2) ean14 dup /xdim get exch dup /xmin get exch /xmax get 3 array astore
} [0.495 0.495 1.016] isEqual
{ 0 0 moveto (\(01\)09521234543213) (strictspec ast=gs1.sst2) ean14 true } true isEqual

% mag scales the height with the X-dimension, as for GS1-128
{
    (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2 mag=1.5) ean14 /bhs get 0 get
    (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2 mag=1.5) /gs1-128 /uk.co.terryburton.bwipp findresource exec /bhs get 0 get
    eq
} true isEqual

{ (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst1) ean14 } /bwipp.renderUnknownAST isError
{ (\(01\)09521234543213) (dontdraw strictspec xdim=0.100) ean14 } /bwipp.renderXdimTooSmall isError
{ (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2 width=2) ean14 } /bwipp.renderStrictspecDimOverride isError
{ (\(01\)09521234543213) (dontdraw strictspec ast=gs1.sst2 height=0.5) ean14 } /bwipp.renderStrictspecDimOverride isError
{ (\(01\)09521234543213) (dontdraw ast=gs1.sst2) ean14 } /bwipp.renderOrphanedAST isError
