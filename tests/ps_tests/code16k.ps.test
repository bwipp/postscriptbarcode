%
% Error tests
%

% Invalid rows (valid: 2-16)
(TEST) (rows=1 dontdraw) /bwipp.code16kBadRows er_tmpl
(TEST) (rows=17 dontdraw) /bwipp.code16kBadRows er_tmpl

% Invalid row height (valid: 8-50)
(TEST) (rowheight=7 dontdraw) /bwipp.code16kBadRowHeight er_tmpl
(TEST) (rowheight=51 dontdraw) /bwipp.code16kBadRowHeight er_tmpl

% Invalid separator height (valid: 1-5)
(TEST) (sepheight=0 dontdraw) /bwipp.code16kBadSepHeight er_tmpl
(TEST) (sepheight=6 dontdraw) /bwipp.code16kBadSepHeight er_tmpl

% Invalid SAM (Structured Append Mode) format
(TEST) (sam=1 dontdraw) /bwipp.code16kBadSAM er_tmpl
(TEST) (sam=110 dontdraw) /bwipp.code16kBadSAM er_tmpl

% Invalid raw format
(TEST) (raw dontdraw) /bwipp.code16kBadRawFormat er_tmpl
(^12A) (raw dontdraw) /bwipp.code16kBadRawFormat er_tmpl
(^12) (raw dontdraw) /bwipp.code16kBadRawFormat er_tmpl
(^1) (raw dontdraw) /bwipp.code16kBadRawFormat er_tmpl
(^) (raw dontdraw) /bwipp.code16kBadRawFormat er_tmpl

% Raw codeword out of range (valid: 0-106)
(^107) (raw dontdraw) /bwipp.code16kBadRawCodeword er_tmpl
(^999) (raw dontdraw) /bwipp.code16kBadRawCodeword er_tmpl

501 string (dontdraw) /bwipp.code16kinputTooLong er_tmpl

% Maximum row and separator height
{ 0 0 moveto (TEST) (rowheight=50 sepheight=5) code16k true } true isEqual

% strictspec smoke test
{ 0 0 moveto (Abcd-1234567890-wxyZ) (strictspec xdim=0.330) code16k true } true isEqual

% sampos and samtotal are an alternative to sam
{ (TEST) (sampos=2 samtotal=3 dontdraw) code16k /pixs get } (TEST) (sam=23 dontdraw) code16k /pixs get isEqual
(TEST) (sam=23 sampos=2 samtotal=3 dontdraw) /bwipp.code16kSAMconflict er_tmpl
(TEST) (sampos=2 dontdraw) /bwipp.code16kSAMincomplete er_tmpl
(TEST) (samtotal=3 dontdraw) /bwipp.code16kSAMincomplete er_tmpl
(TEST) (sampos=1 samtotal=1 dontdraw) /bwipp.code16kBadSAMtotal er_tmpl
(TEST) (sampos=1 samtotal=10 dontdraw) /bwipp.code16kBadSAMtotal er_tmpl
(TEST) (sampos=0 samtotal=3 dontdraw) /bwipp.code16kBadSAMpos er_tmpl
(TEST) (sampos=4 samtotal=3 dontdraw) /bwipp.code16kBadSAMpos er_tmpl

% FNC1 in second position: D1 is the AIM application indicator in code set B or C, and D2 is FNC1
{ (^FNC@TABC) (parsefnc debugcws) code16k } [1 52 102 33 34 35 103 103 42 64] debugIsEqual
{ (^FNC@tabc) (parsefnc debugcws) code16k } [1 84 102 65 66 67 103 103 72 22] debugIsEqual
{ (^FNC@12abcdefgh) (parsefnc debugcws) code16k } [9 12 102 100 65 66 67 68 69 70 71 72 103 55 58] debugIsEqual
{ (^FNC@T1234) (parsefnc debugcws) code16k } [1 52 102 99 12 34 103 103 19 5] debugIsEqual
{ (^FNC@12^FNC134) (parsefnc debugcws) code16k } [2 12 102 102 34 103 103 103 103 41] debugIsEqual
{ (^FNC@TABC) (parsefnc sampos=1 samtotal=2 dontdraw) code16k } /bwipp.code16kSAMfnc1second isError
{ (A^FNC@TABC) (parsefnc dontdraw) code16k } /bwipp.code16kFNC1secondNotFirst isError

