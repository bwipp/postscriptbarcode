%
% Error tests
%

% Empty data
() (dontdraw) /bwipp.hanxinEmptyData er_tmpl

% Invalid version (valid: 1-84)
(TEST) (version=0 dontdraw) /bwipp.hanxinInvalidVersion er_tmpl
(TEST) (version=85 dontdraw) /bwipp.hanxinInvalidVersion er_tmpl

% Invalid error correction level (valid: L1-L4)
(TEST) (eclevel=L0 dontdraw) /bwipp.hanxinInvalidErrorCorrectionLevel er_tmpl
(TEST) (eclevel=L5 dontdraw) /bwipp.hanxinInvalidErrorCorrectionLevel er_tmpl

% Invalid mask (valid: 0-3)
(TEST) (mask=5 dontdraw) /bwipp.hanxinInvalidErrorCorrectionLevel er_tmpl

% Data too long for symbol
(ABCDEFGHIJKLMNOPQRSTUVWXYZ) (version=1 dontdraw) /bwipp.hanxinNoValidSymbol er_tmpl

% Input too long (raw input guard, before parseinput)
14001 string (dontdraw) /bwipp.hanxinInputTooLong er_tmpl

% Input too long (post-parse guard: any input larger than the absolute symbol capacity)
{ 7828 string 0 1 7827 { 1 index exch 49 put } for (dontdraw) hanxin } /bwipp.hanxinInputTooLong isError

% FNC1 outside first position is invalid when GS1 mode isn't active
(ABC^FNC1123) (parsefnc dontdraw) /bwipp.hanxinFNC1NotFirstPosition er_tmpl
(ABC123^FNC1) (parsefnc dontdraw) /bwipp.hanxinFNC1NotFirstPosition er_tmpl

% ECIs are not available in GS1 mode, which must be the first mode
(^FNC1ABC^ECI000003123) (parsefnc dontdraw) /bwipp.hanxinECIwithFNC1 er_tmpl
(^ECI000003^FNC1ABC123) (parsefnc dontdraw) /bwipp.hanxinFNC1NotFirstPosition er_tmpl

{ (TEST) (version=1 dontdraw) hanxin pop true } true isEqual
{ (TEST) (version=84 dontdraw) hanxin pop true } true isEqual
{ (TEST) (eclevel=L1 dontdraw) hanxin pop true } true isEqual
{ (TEST) (eclevel=L4 dontdraw) hanxin pop true } true isEqual
(TEST) (mask=-2 dontdraw) /bwipp.hanxinInvalidErrorCorrectionLevel er_tmpl

% strictspec smoke test
{ 0 0 moveto (This is Han Xin) (strictspec xdim=0.330) hanxin true } true isEqual

