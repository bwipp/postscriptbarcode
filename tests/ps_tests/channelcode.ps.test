/channelcode dup /uk.co.terryburton.bwipp findresource cvx def

% Figures

/eq_tmpl {  % data options sbs
    3 1 roll { 0 0 channelcode /sbs get }
    dup 3 -1 roll 1 exch put
    dup 3 -1 roll 0 exch put
    exch debugIsEqual
} def

% AIM BC12-1998 USS Channel Code Figure F1, same
{ (3493) (dontdraw) channelcode /sbs get
} [ 1 1 1 1 1 1 1 1 1 5 4 1 1 1 2 1 1 1 1 ] debugIsEqual
