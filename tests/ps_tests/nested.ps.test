/code128 dup /uk.co.terryburton.bwipp findresource cvx def
/ean13 dup /uk.co.terryburton.bwipp findresource cvx def
/qrcode dup /uk.co.terryburton.bwipp findresource cvx def
/gs1qrcode dup /uk.co.terryburton.bwipp findresource cvx def
/isbn dup /uk.co.terryburton.bwipp findresource cvx def

%
% Run a procedure as a host that sets _dontdraw to obtain the structure
%
/hostdd {
    userdict /uk.co.terryburton.bwipp._dontdraw true put
    stopped
    userdict /uk.co.terryburton.bwipp._dontdraw undef
    { stop } if
} def

%
% A host requesting the structure gets the outermost encoder's validation
%
{ { (ABC) (xdim=0.3) code128 } hostdd } /bwipp.renderOrphanedXdim isError
{ { (ABC) (hdim=10) code128 } hostdd } /bwipp.renderOrphanedHdim isError
{ { (9520123456788) (mag=2) ean13 } hostdd } /bwipp.renderOrphanedMag isError
{ { (9520123456788) (ast=gs1.sst2) ean13 } hostdd } /bwipp.renderOrphanedAST isError
{ { (ABC) (strictspec loosespec) code128 } hostdd } /bwipp.renderSpecModeMutex isError
{ { (ABC) (strictspec propspec) qrcode } hostdd } /bwipp.renderSpecModeMutex isError
{ { (9520123456788) (strictspec height=0.5) ean13 } hostdd } /bwipp.renderStrictspecDimOverride isError
{ { (978-1-56581-231-4) (mag=2) isbn } hostdd } /bwipp.renderOrphanedMag isError
{ { (\(01\)09521234543213) (strictspec loosespec) gs1qrcode } hostdd } /bwipp.renderSpecModeMutex isError

%
% A host requesting the structure gets the structure of a direct call
%
{
    { (9520123456788) (loosespec height=0.5) ean13 } hostdd
    dup /strictspec get exch /bhs get 0 get 2 array astore
} [false 0.5] isEqual

%
% A host requesting the structure gets the global spec defaults
%
/tmp uk.co.terryburton.bwipp.global_ctx def
/uk.co.terryburton.bwipp.global_ctx << /enabledebug true /enabledontdraw true /loosespec true >> def
{
    { (9520123456788) () ean13 } hostdd
    dup /strictspec get exch /xdim get 2 array astore
} [true 0.330] isEqual
/uk.co.terryburton.bwipp.global_ctx << /enabledebug true /enabledontdraw true /strictspec true >> def
{ { (ABC) () qrcode } hostdd } /bwipp.renderNeedXnom isError
/uk.co.terryburton.bwipp.global_ctx tmp def

%
% The markers set by a parent do not outlive it
%
{
    (978-1-56581-231-4) (dontdraw) isbn pop
    (9520123456788) (mag=2) ean13
} /bwipp.renderOrphanedMag isError

{
    (\(01\)09521234543213) (dontdraw) gs1qrcode pop
    (ABC) (xdim=0.3) qrcode
} /bwipp.renderOrphanedXdim isError

{
    (9520123456788) (dontdraw) ean13 pop
    (ABC) (dontdraw) code128 /bhs get 0 get 1 array astore
} [1.0] isEqual

%
% ... including when the sub-encoder raises an error
%
{
    mark { (\(01\)09521234543213) (eclevel=Z) gs1qrcode } stopped cleartomark
    (ABC) (xdim=0.3) qrcode
} /bwipp.renderOrphanedXdim isError

{
    mark { (978-1-56581-231-4 1234X) (dontdraw) isbn } stopped cleartomark
    (9520123456788) (mag=2) ean13
} /bwipp.renderOrphanedMag isError

%
% Every encoder that delegates to another validates spec options and applies
% the global spec defaults once, alike for a direct call, the dontdraw option
% and a host that sets _dontdraw, and a host gets the structure of a direct call
%
/cat {
    2 dict begin
    /b exch def /a exch def
    a length b length add string dup 0 a putinterval dup a length b putinterval
    end
} def

/structkey { dup /ren get /renlinear eq { /sbs } { /pixs } ifelse get } def

/parent_tmpl {  % [ /encoder (data) (options) ]
    aload pop /o exch def /d exch def /uk.co.terryburton.bwipp findresource cvx /enc exch def

    { d o ( xdim=0.3) cat enc } /bwipp.renderOrphanedXdim isError
    { d o ( dontdraw xdim=0.3) cat enc } /bwipp.renderOrphanedXdim isError
    { { d o ( xdim=0.3) cat enc } hostdd } /bwipp.renderOrphanedXdim isError

    /tmp uk.co.terryburton.bwipp.global_ctx def
    /uk.co.terryburton.bwipp.global_ctx << /enabledebug true /enabledontdraw true /loosespec true >> def
    { d o ( dontdraw xdim=0.5) cat enc dup /strictspec get exch /xdim get 2 array astore } [true 0.5] isEqual
    { { d o ( xdim=0.5) cat enc } hostdd dup /strictspec get exch /xdim get 2 array astore } [true 0.5] isEqual
    /uk.co.terryburton.bwipp.global_ctx << /enabledebug true /enabledontdraw true /strictspec true >> def
    { d o ( dontdraw xdim=0.5) cat enc dup /strictspec get exch /xdim get 2 array astore } [true 0.5] isEqual
    { { d o ( xdim=0.5) cat enc } hostdd dup /strictspec get exch /xdim get 2 array astore } [true 0.5] isEqual
    /uk.co.terryburton.bwipp.global_ctx tmp def

    { { d o enc } hostdd structkey } d o ( dontdraw) cat enc structkey isEqual
} def

