/epcqrcode dup /uk.co.terryburton.bwipp findresource cvx def

/ok_tmpl {
    { 0 0 epcqrcode /pixx get 0 gt }
    dup 3 -1 roll 1 exch put
    dup 3 -1 roll 0 exch put
    true isEqual
} def

