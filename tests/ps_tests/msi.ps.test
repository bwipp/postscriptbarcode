% Barcode Writer in Pure PostScript
% https://bwipp.terryburton.co.uk
%
% vim: set sw=4 sts=4 et:
%
% Copyright (c) 2004-2026 Terry Burton
%

/msi dup /uk.co.terryburton.bwipp findresource cvx def


% (2211) produces mod-11 '10' check digit
{ (2211) (dontdraw includecheck checktype=mod11 badmod11) msi /sbs get
} [2 1 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 1 2 1] debugIsEqual

{ (2211) (dontdraw includecheck checktype=ncrmod11 badmod11) msi /sbs get
} [2 1 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 1 2 1] debugIsEqual

{ (2211) (dontdraw includecheck checktype=mod1110 badmod11) msi /sbs get
} [2 1 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 1 2 1 2 1 2 1 2 1 2 1] debugIsEqual

{ (2211) (dontdraw includecheck checktype=ncrmod1110 badmod11) msi /sbs get
} [2 1 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 2 1 1 2 1 2 1 2 1 2 1 2 1 2 1 2 1 2 1 2 1] debugIsEqual

{ (2211) (dontdraw includecheck checktype=mod10 badmod11) msi
} /bwipp.msiBadMod11Mismatch isError

{ (2211) (dontdraw includecheck checktype=mod1010 badmod11) msi
} /bwipp.msiBadMod11Mismatch isError

{ (2211) (dontdraw includecheck checktype=mod11) msi
} /bwipp.msiBadMod11NotSpecified isError

% (1234567) produces different check digit for mod11 and ncrmod11
{ (1234567) (dontdraw includecheck checktype=mod11) msi /sbs get
} [2 1 1 2 1 2 1 2 2 1 1 2 1 2 2 1 1 2 1 2 1 2 2 1 2 1 1 2 2 1 1 2 1 2 1 2 2 1 1 2 2 1 1 2 2 1 2 1 1 2 1 2 2 1 2 1 2 1 1 2 2 1 1 2 1 2 1 2 1] debugIsEqual

{ (1234567) (dontdraw includecheck checktype=ncrmod11) msi /sbs get
} [2 1 1 2 1 2 1 2 2 1 1 2 1 2 2 1 1 2 1 2 1 2 2 1 2 1 1 2 2 1 1 2 1 2 1 2 2 1 1 2 2 1 1 2 2 1 2 1 1 2 1 2 2 1 2 1 2 1 2 1 1 2 1 2 2 1 1 2 1] debugIsEqual

{ (123A) (dontdraw) msi
} /bwipp.msiBadCharacter isError

{ (1234) (checktype=mod10 dontdraw) msi
} /bwipp.msiCheckTypeWithoutCheck isError

{ 501 string (dontdraw) msi } /bwipp.msiinputTooLong isError


%
% Smoke test: strictspec renders without error
%
/ok_tmpl {
    { 0 0 moveto 0 0 msi true } dup 3 -1 roll 4 exch put dup 3 -1 roll 3 exch put
    true isEqual
} def
(0123456789)  (includetext strictspec xdim=0.330)  ok_tmpl

% propspec smoke test
{ 0 0 moveto (0123456789) (propspec) msi true } true isEqual


%
% Check digit: the digit expected in the error, and the digit added on request
%
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (0123456789) (dontdraw includecheck) msi pop uk.co.terryburton.bwipp.report /checkdigit known { uk.co.terryburton.bwipp.report /checkdigit get } { null } ifelse end } (7) isEqual
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (0123456789) (dontdraw includecheck checktype=mod1010) msi pop uk.co.terryburton.bwipp.report /checkdigit known { uk.co.terryburton.bwipp.report /checkdigit get } { null } ifelse end } (78) isEqual

%
% validatecheck: the final digits are the check digits of the checktype, which are verified, then encoded as with includecheck
%
{ (01234567897) (dontdraw validatecheck checktype=mod10) msi /sbs get } (0123456789) (dontdraw includecheck checktype=mod10) msi /sbs get isEqual
{ (012345678978) (dontdraw validatecheck checktype=mod1010) msi /sbs get } (0123456789) (dontdraw includecheck checktype=mod1010) msi /sbs get isEqual
{ (01234567892) (dontdraw validatecheck checktype=mod11) msi /sbs get } (0123456789) (dontdraw includecheck checktype=mod11) msi /sbs get isEqual
{ (01234567897) (dontdraw validatecheck checktype=ncrmod11) msi /sbs get } (0123456789) (dontdraw includecheck checktype=ncrmod11) msi /sbs get isEqual
{ (012345678929) (dontdraw validatecheck checktype=mod1110) msi /sbs get } (0123456789) (dontdraw includecheck checktype=mod1110) msi /sbs get isEqual
{ (012345678978) (dontdraw validatecheck checktype=ncrmod1110) msi /sbs get } (0123456789) (dontdraw includecheck checktype=ncrmod1110) msi /sbs get isEqual
{ (100910) (dontdraw validatecheck checktype=mod11 badmod11) msi /sbs get } (1009) (dontdraw includecheck checktype=mod11 badmod11) msi /sbs get isEqual  % Two-digit check of 10
{ (1009109) (dontdraw validatecheck checktype=mod1110 badmod11) msi /sbs get } (1009) (dontdraw includecheck checktype=mod1110 badmod11) msi /sbs get isEqual
{ (0) (dontdraw validatecheck) msi /sbs get } () (dontdraw includecheck) msi /sbs get isEqual  % Degenerate case with check digit only
{ (01234567890) (dontdraw validatecheck checktype=mod1010) msi } [/bwipp.msiBadCheckDigit (Incorrect MSI check digits provided: expected 22, not 90)] isErrorInfo
{ (10091) (dontdraw validatecheck checktype=mod11 badmod11) msi } [/bwipp.msiBadCheckDigit (Incorrect MSI check digits provided: expected 10, not 1)] isErrorInfo
{ () (dontdraw validatecheck) msi } /bwipp.msiTooShort isError
{ (1) (dontdraw validatecheck checktype=mod1010) msi } /bwipp.msiTooShort isError
{ 10 dict begin /uk.co.terryburton.bwipp.report 1 dict def (01234567897) (dontdraw validatecheck) msi pop uk.co.terryburton.bwipp.report /checkdigit known end } false isEqual

%
% validatecheck with short inputs raises a BWIPP error or encodes
%

{ (1) (dontdraw validatecheck checktype=mod1110) msi } /bwipp.msiTooShort isError
{ (1) (dontdraw validatecheck checktype=ncrmod1110) msi } /bwipp.msiTooShort isError
{ (1) (dontdraw validatecheck badmod11 checktype=mod1110) msi } /bwipp.msiTooShort isError
{ (1) (dontdraw validatecheck badmod11 checktype=ncrmod1110) msi } /bwipp.msiTooShort isError
{ (00) (dontdraw validatecheck checktype=mod1010) msi /sbs get } () (dontdraw includecheck checktype=mod1010) msi /sbs get isEqual
{ (00) (dontdraw validatecheck checktype=mod1110) msi /sbs get } () (dontdraw includecheck checktype=mod1110) msi /sbs get isEqual
{ (0) (dontdraw validatecheck checktype=mod11) msi /sbs get } () (dontdraw includecheck checktype=mod11) msi /sbs get isEqual
{ (0) (dontdraw validatecheck checktype=ncrmod11) msi /sbs get } () (dontdraw includecheck checktype=ncrmod11) msi /sbs get isEqual
